---
/**
 * The advertising index.
 *
 * This was twelve stacked sections, one per client, each a heading over a grid.
 * The repetition was structural rather than cosmetic: twelve identical blocks
 * read as an archive however they are styled, and they gave a one-off
 * restaurant ad exactly the same billing as a GTBank campaign.
 *
 * So the sections are gone. One grid holds every piece, and the client roster is
 * promoted into the headline as the filter. That removes the repetition at its
 * source and puts the actual selling point where it can be read in one glance —
 * GTBank, MTN, Sterling, KFC in a line beats twelve headings you scroll past.
 *
 * Filtering is CSS only. A radio per client sits before the grid, and generated
 * `:checked ~` rules hide the pieces that do not match. No JavaScript, so it
 * works on first paint and cannot break; the radios keep it keyboard-operable
 * and announce as a group.
 *
 * Nothing here has a brief behind it, so there is no honest problem-and-outcome
 * story to write for a Valentine's post. The work is the argument.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { Image, getImage } from 'astro:assets';
import { CAMPAIGNS } from '../../data/site';
import Lightbox from '../../components/Lightbox.astro';
import { tilt } from '../../lib/tilt';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const pieces = CAMPAIGNS.map((c) => {
  const hit = Object.keys(files).find((k) => k.endsWith(`/${c.image}`));
  return {
    ...c,
    id: slug(c.client),
    img: hit ? files[hit].default : undefined,
    ...tilt(c.image),
  };
});

/** Roster in first-appearance order, which is already most-recognised first. */
const clients: { id: string; name: string; count: number }[] = [];
for (const p of pieces) {
  const found = clients.find((c) => c.id === p.id);
  if (found) found.count += 1;
  else clients.push({ id: p.id, name: p.client, count: 1 });
}

/**
 * Viewer artwork, resolved at build time but not attached until it is needed.
 *
 * These used to be <Image loading="lazy"> inside the closed dialog, on the
 * assumption that a hidden image is not fetched. It is not true: lazy loading
 * defers on viewport proximity, and an element in a display:none subtree has no
 * intersection to measure, so browsers fetch it immediately. All 24 stage
 * images and all 24 thumbnails were being pulled on every page load for a
 * dialog most visitors never open — 72 image requests for a page that shows 24.
 *
 * So the URLs are computed here and parked in data attributes; the script
 * promotes them to src/srcset the first time a slide is shown, and warms the
 * two either side of it.
 */
const shots = await Promise.all(
  pieces.map((p) =>
    p.img
      ? getImage({ src: p.img, widths: [600, 900, 1400], format: 'webp' })
      : null,
  ),
);
const thumbShots = await Promise.all(
  pieces.map((p) => (p.img ? getImage({ src: p.img, widths: [120, 240], format: 'webp' }) : null)),
);

const lbSlides = pieces.flatMap((p, i) =>
  shots[i] && p.img
    ? [{
        src: shots[i]!.src,
        srcSet: shots[i]!.srcSet.attribute,
        alt: `${p.client} — ${p.caption}`,
        width: p.img.width,
        height: p.img.height,
        caption: p.caption,
        data: { client: p.id, 'client-name': p.client },
      }]
    : [],
);

/**
 * The filter rules, written out rather than scripted. One `:checked` selector
 * per client hides everything else, and a second lights its own label. Emitted
 * as a plain <style> so the generated selectors survive — Astro's scoping
 * rewrites authored CSS only.
 */
const filterCss = clients
  .map(
    ({ id }) => `
#f-${id}:checked ~ .index .piece:not([data-client='${id}']) { display: none; }
#f-${id}:checked ~ .roster label[for='f-${id}'] { color: var(--color-ink); }
#f-${id}:focus-visible ~ .roster label[for='f-${id}'] { outline: 2px solid var(--color-accent); outline-offset: 3px; }`,
  )
  .join('\n');
---

<Base
  title="Campaigns"
  description={`Print, social and digital advertising from Ojú — ${pieces.length} pieces across ${clients.length} brands.`}
>
  <SiteHeader current="/work" />
  <main id="main">
    <section class="rule-t gutter pt-12 pb-8 md:pt-16 md:pb-10">
      <p class="label mb-4">
        <a href="/work" class="backlink">Work</a> <span aria-hidden="true">/</span> Campaigns
      </p>
      <h1 class="font-display max-w-4xl text-[40px] leading-[1.05] tracking-tight md:text-[68px]">
        Print, social<br />and digital ads
      </h1>
      <p class="mt-6 max-w-lg text-soft">
        {pieces.length} pieces across {clients.length} names, for banks, telcos and
        restaurant brands. The craft side of the studio, shown without commentary.
      </p>
    </section>

    <form class="filter gutter">
      <fieldset>
        <legend class="sr-only">Filter campaigns by client</legend>

        <input class="sr-only" type="radio" name="client" id="f-all" checked />
        {clients.map((c) => <input class="sr-only" type="radio" name="client" id={`f-${c.id}`} />)}

        {/* The roster is the headline. Set at display size, muted until chosen. */}
        <div class="roster font-display">
          <label for="f-all">All</label>{' '}{
            /* The space between labels is load-bearing: it is the only line-break
               opportunity between them, and without it the roster runs off the
               page as one 2,488px line instead of wrapping. */
            clients.map((c) => (
              <>
                <label for={`f-${c.id}`}>{c.name}<sup class="roster__n">{c.count}</sup></label>{' '}
              </>
            ))
          }
        </div>

        <ul class="index">
          {
            pieces.map((p, i) => (
              <li
                class:list={['piece', p.feature && 'piece--feature']}
                data-client={p.id}
                style={`--rot:${p.rot}deg; --dy:${p.dy}px`}
              >
                {p.img && (
                  <button type="button" class="piece__open" data-open={i} aria-label={`View ${p.client}: ${p.caption}`}>
                    <Image
                      src={p.img}
                      alt=""
                      widths={[300, 600, 900]}
                      sizes="(min-width: 1024px) 24vw, (min-width: 640px) 32vw, 46vw"
                      loading="lazy"
                      decoding="async"
                      class="piece__img"
                    />
                  </button>
                )}
                <span class="piece__label" aria-hidden="true">
                  <b>{p.client}</b> {p.caption}
                </span>
              </li>
            ))
          }
        </ul>
      </fieldset>
    </form>

    {/* The viewer. A native <dialog> opened with showModal(), which brings Esc,
        a focus trap, an inert background and a ::backdrop with it — all things
        that are tedious and easy to get wrong by hand. */}
    <Lightbox label="Campaign viewer" slides={lbSlides}>
      <Fragment slot="bar">
        <span class="lb__n" data-lb-index>1</span>
        <span class="lb__of"> / {pieces.length}</span>
        <span aria-hidden="true"> &middot; </span>
        <span data-lb-client />
      </Fragment>
      <Fragment slot="meta">
        <p class="lb__caption" data-lb-caption />
        <p class="lb__source font-mono" data-lb-source />
      </Fragment>
      <div class="lb__strip" slot="strip" role="group" aria-label="Jump to a piece">
        {
          pieces.map((p, i) =>
            thumbShots[i] ? (
              <button type="button" class="lb__thumb" data-lb-goto={i} aria-label={`${p.client}: ${p.caption}`}>
                {/* Parked like the stage slides: lazy loading does not defer
                    inside a closed dialog, so a src here pulls all 24 on every
                    visit for a filmstrip nobody has opened. */}
                <img alt="" decoding="async" data-src={thumbShots[i]!.src} data-srcset={thumbShots[i]!.srcSet.attribute} sizes="72px" />
              </button>
            ) : null,
          )
        }
      </div>
    </Lightbox>

    <section class="rule-t gutter py-14 md:py-20">
      <p class="max-w-xl text-soft">
        The projects with a story behind them are on
        <a href="/work" class="inline-link">the work page</a>.
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style is:global set:html={filterCss}></style>

<style>
  .backlink,
  .inline-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 200ms ease;
  }
  .backlink:hover,
  .inline-link:hover { border-color: currentColor; }

  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }

  /* Visually hidden but still focusable — display:none would take the radios
     out of the tab order and lose keyboard filtering entirely. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── the roster, doubling as the filter ─────────────────────────── */
  .roster {
    font-size: clamp(1.25rem, 3.2vw, 2.125rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-rule);
    padding: 1.5rem 0 2.5rem;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .roster { padding: 2rem 0 3.5rem; }
  }

  .roster label {
    color: var(--color-faint);
    cursor: pointer;
    transition: color 180ms ease;
    /* The comma belongs to the name before it. As a separate element it could
       wrap to the start of a line, which is where the stray leading commas
       came from. */
    white-space: nowrap;
  }
  .roster label:not(:last-child)::after {
    content: ',';
    color: var(--color-rule);
    margin-right: 0.3em;
  }
  .roster label:hover { color: var(--color-ink); }

  /* "All" is the state on load, so it starts lit. A later :checked rule for a
     client overrides this by source order. */
  #f-all:checked ~ .roster label[for='f-all'] { color: var(--color-ink); }
  #f-all:focus-visible ~ .roster label[for='f-all'] {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .roster__n {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.34em;
    vertical-align: super;
    letter-spacing: 0;
    margin-left: 0.15em;
    opacity: 0.75;
  }

  /* ── the board ──────────────────────────────────────────────────
     Columns rather than a grid. A grid of equal cells has to letterbox or crop
     to fill them; on a board the pieces keep their own size and the varying
     heights are the point — that is what stops it reading as a contact sheet.

     Transforms do not affect layout, so the tilt and the overlap are purely
     visual. The columns underneath stay orderly, which is what lets the filter
     hide a piece and have the rest simply close up rather than leave a hole in
     a collage. */
  .index {
    columns: 2;
    column-gap: 1.25rem;
    list-style: none;
    padding: 0 0 4rem;
    margin: 0;
  }
  @media (min-width: 640px) {
    .index { columns: 3; column-gap: 1.75rem; }
  }
  @media (min-width: 1024px) {
    .index { columns: 4; column-gap: 2.25rem; }
  }

  .piece {
    position: relative;
    /* Without this a piece can be split down a column boundary. */
    break-inside: avoid;
    margin-bottom: 2.25rem;
    transform: rotate(var(--rot, 0deg)) translateY(var(--dy, 0px));
    transition: transform 380ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  @media (min-width: 640px) {
    .piece { margin-bottom: 3rem; }
  }

  /* The pieces that carry a campaign sit a little larger, so the board has a
     couple of anchors rather than 24 items of equal weight. */
  .piece--feature {
    --lift: 1.06;
  }

  .piece__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(23 22 15 / 0.1);
    border-radius: 2px;
    background: var(--color-fill);
    /* Two shadows: a tight one for the paper's own edge, a wide soft one for
       the distance it sits off the board. */
    box-shadow:
      0 2px 6px rgb(23 22 15 / 0.07),
      0 14px 34px rgb(23 22 15 / 0.06);
    transition: box-shadow 380ms ease, border-color 380ms ease;
  }

  /* Hover straightens the piece and lifts it clear of its neighbours. The
     straightening is what makes the board feel like paper rather than a set of
     rotated boxes — the tilt has to be undone, not merely scaled. */
  .piece:hover,
  .piece:focus-within {
    transform: rotate(0deg) scale(var(--lift, 1.045));
    z-index: 20;
  }
  .piece:hover .piece__img,
  .piece:focus-within .piece__img {
    border-color: rgb(23 22 15 / 0.18);
    box-shadow:
      0 8px 18px rgb(23 22 15 / 0.1),
      0 34px 70px rgb(23 22 15 / 0.16);
  }

  /* Sits under the piece rather than over it: these are adverts, and a caption
     laid across one covers the work it is describing. */
  .piece__label {
    position: absolute;
    inset: auto auto -1.75rem 0;
    width: 100%;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--color-faint);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 240ms ease, transform 240ms ease;
    pointer-events: none;
  }
  .piece__label b {
    color: var(--color-ink);
    font-weight: 600;
    margin-right: 0.35em;
  }

  .piece:hover .piece__label,
  .piece:focus-within .piece__label {
    opacity: 1;
    transform: none;
  }

  /* Touch has no hover, so the caption would never appear. It is shown there,
     and the piece is given the room it needs underneath. */
  @media (hover: none) {
    .piece__label { opacity: 1; transform: none; }
    .piece { margin-bottom: 3.25rem; }
  }


  /* ── the piece as a trigger ─────────────────────────────────────── */
  .piece__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  /* The straighten already keys off :focus-within, so a keyboard user gets the
     same lift as the mouse without another rule. */
  .piece__open:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  /* Page-specific viewer copy. The shell owns everything structural. */
  :global(.lb__n) { color: var(--color-paper); }
  :global(.lb__caption) { font-size: 0.9375rem; line-height: 1.5; }
  @media (min-width: 768px) {
    :global(.lb__caption) { font-size: 1.0625rem; }
  }
  :global(.lb__source) {
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 239 233 / 0.55);
  }

  :global(.lb__strip) {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    z-index: 3;
  }
  :global(.lb__strip::-webkit-scrollbar) { display: none; }

  :global(.lb__thumb) {
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    line-height: 0;
    opacity: 0.4;
    transition: opacity 200ms ease;
  }
  :global(.lb__thumb img) {
    height: 40px;
    width: auto;
    border-radius: 2px;
  }
  @media (min-width: 768px) {
    :global(.lb__thumb img) { height: 44px; }
  }
  :global(.lb__thumb:hover) { opacity: 0.75; }
  :global(.lb__thumb[aria-current='true']) {
    opacity: 1;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  :global(.lb__thumb:focus-visible) {
    opacity: 1;
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.lb__thumb) { transition: none; }
  }

  /* The tilt is a static arrangement, not motion, so it stays. What goes is the
     movement between states. */
  @media (prefers-reduced-motion: reduce) {
    .piece,
    .piece__img,
    .piece__label {
      transition: none;
    }
    .piece:hover,
    .piece:focus-within {
      transform: rotate(var(--rot, 0deg)) translateY(var(--dy, 0px));
    }
  }
</style>

<script>
  /**
   * The campaign viewer.
   *
   * The scope is whatever the roster filter leaves visible, so with one client
   * chosen the arrows move through that client's pieces only and the counter
   * reads within them — stepping into hidden work would contradict the page.
   */
  import { createLightbox } from '../../lib/lightbox';

  const root = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-open]')];

  if (root && openers.length) {
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-lb-goto]')];
    const idxEl = root.querySelector<HTMLElement>('[data-lb-index]');
    const ofEl = root.querySelector<HTMLElement>('.lb__of');
    const clientEl = root.querySelector<HTMLElement>('[data-lb-client]');
    const captionEl = root.querySelector<HTMLElement>('[data-lb-caption]');
    const sourceEl = root.querySelector<HTMLElement>('[data-lb-source]');

    /** Indices the roster filter leaves on the board, in document order. */
    const scope = () => {
      const list = openers
        .map((b, i) => ({ i, li: b.closest<HTMLElement>('.piece') }))
        .filter(({ li }) => li && getComputedStyle(li).display !== 'none')
        .map(({ i }) => i);
      return list.length ? list : openers.map((_, i) => i);
    };

    /** The filmstrip is only ever seen with the dialog open. */
    const attachThumbs = () =>
      thumbs.forEach((t) => {
        const img = t.querySelector('img');
        if (!img || img.getAttribute('src')) return;
        const { src, srcset } = img.dataset;
        if (srcset) img.setAttribute('srcset', srcset);
        if (src) img.setAttribute('src', src);
      });

    const lb = createLightbox(root, {
      scope,
      onOpen: attachThumbs,
      onShow: ({ slide, index, position, total }) => {
        const client = slide.dataset.clientName ?? '';
        if (idxEl) idxEl.textContent = String(position);
        if (ofEl) ofEl.textContent = ` / ${total}`;
        if (clientEl) clientEl.textContent = client;
        if (captionEl) captionEl.textContent = slide.dataset.caption ?? '';
        if (sourceEl) sourceEl.textContent = client;

        const set = scope();
        thumbs.forEach((t, i) => {
          t.setAttribute('aria-current', String(i === index));
          // A thumb for a filtered-out piece is not a place the arrows can
          // reach, so it should not be offered as a shortcut either.
          t.hidden = !set.includes(i);
        });
        thumbs[index]?.scrollIntoView({ block: 'nearest', inline: 'center' });
      },
    });

    if (lb) {
      openers.forEach((b, i) => b.addEventListener('click', () => lb.open(i, b)));
      thumbs.forEach((t, i) =>
        t.addEventListener('click', () => lb.show(i, i > lb.slides.findIndex((s) => s.classList.contains('is-current')) ? 1 : -1)),
      );
    }
  }
</script>
