---
/**
 * The advertising index.
 *
 * This was twelve stacked sections, one per client, each a heading over a grid.
 * The repetition was structural rather than cosmetic: twelve identical blocks
 * read as an archive however they are styled, and they gave a one-off
 * restaurant ad exactly the same billing as a GTBank campaign.
 *
 * So the sections are gone. One grid holds every piece, and the client roster is
 * promoted into the headline as the filter. That removes the repetition at its
 * source and puts the actual selling point where it can be read in one glance —
 * GTBank, MTN, Sterling, KFC in a line beats twelve headings you scroll past.
 *
 * Filtering is CSS only. A radio per client sits before the grid, and generated
 * `:checked ~` rules hide the pieces that do not match. No JavaScript, so it
 * works on first paint and cannot break; the radios keep it keyboard-operable
 * and announce as a group.
 *
 * Nothing here has a brief behind it, so there is no honest problem-and-outcome
 * story to write for a Valentine's post. The work is the argument.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import { CAMPAIGNS } from '../../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const pieces = CAMPAIGNS.map((c) => {
  const hit = Object.keys(files).find((k) => k.endsWith(`/${c.image}`));
  return { ...c, id: slug(c.client), img: hit ? files[hit].default : undefined };
});

/** Roster in first-appearance order, which is already most-recognised first. */
const clients: { id: string; name: string; count: number }[] = [];
for (const p of pieces) {
  const found = clients.find((c) => c.id === p.id);
  if (found) found.count += 1;
  else clients.push({ id: p.id, name: p.client, count: 1 });
}

/**
 * The filter rules, written out rather than scripted. One `:checked` selector
 * per client hides everything else, and a second lights its own label. Emitted
 * as a plain <style> so the generated selectors survive — Astro's scoping
 * rewrites authored CSS only.
 */
const filterCss = clients
  .map(
    ({ id }) => `
#f-${id}:checked ~ .index .piece:not([data-client='${id}']) { display: none; }
#f-${id}:checked ~ .roster label[for='f-${id}'] { color: var(--color-ink); }
#f-${id}:focus-visible ~ .roster label[for='f-${id}'] { outline: 2px solid var(--color-accent); outline-offset: 3px; }`,
  )
  .join('\n');
---

<Base
  title="Campaigns"
  description={`Print, social and digital advertising from Ojú — ${pieces.length} pieces across ${clients.length} brands.`}
>
  <SiteHeader current="/work" />
  <main id="main">
    <section class="border-t border-rule gutter pt-12 pb-8 md:pt-16 md:pb-10">
      <p class="label mb-4">
        <a href="/work" class="backlink">Work</a> <span aria-hidden="true">/</span> Campaigns
      </p>
      <h1 class="font-display max-w-4xl text-[40px] leading-[1.05] tracking-tight md:text-[68px]">
        Print, social<br />and digital ads
      </h1>
      <p class="mt-6 max-w-lg text-soft">
        {pieces.length} pieces across {clients.length} names, for banks, telcos and
        restaurant brands. The craft side of the studio, shown without commentary.
      </p>
    </section>

    <form class="filter gutter">
      <fieldset>
        <legend class="sr-only">Filter campaigns by client</legend>

        <input class="sr-only" type="radio" name="client" id="f-all" checked />
        {clients.map((c) => <input class="sr-only" type="radio" name="client" id={`f-${c.id}`} />)}

        {/* The roster is the headline. Set at display size, muted until chosen. */}
        <div class="roster font-display">
          <label for="f-all">All</label>{' '}{
            /* The space between labels is load-bearing: it is the only line-break
               opportunity between them, and without it the roster runs off the
               page as one 2,488px line instead of wrapping. */
            clients.map((c) => (
              <>
                <label for={`f-${c.id}`}>{c.name}<sup class="roster__n">{c.count}</sup></label>{' '}
              </>
            ))
          }
        </div>

        <ul class="index">
          {
            pieces.map((p) => (
              <li class:list={['piece', p.feature && 'piece--feature']} data-client={p.id}>
                {p.img && (
                  <Image
                    src={p.img}
                    alt={`${p.client} — ${p.caption}`}
                    widths={[300, 600, 900]}
                    sizes="(min-width: 1024px) 22vw, (min-width: 640px) 32vw, 45vw"
                    loading="lazy"
                    decoding="async"
                    class="piece__img"
                  />
                )}
                <span class="piece__label">
                  <b>{p.client}</b> {p.caption}
                </span>
              </li>
            ))
          }
        </ul>
      </fieldset>
    </form>

    <section class="border-t border-rule gutter py-14 md:py-20">
      <p class="max-w-xl text-soft">
        The projects with a story behind them are on
        <a href="/work" class="inline-link">the work page</a>.
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style is:global set:html={filterCss}></style>

<style>
  .backlink,
  .inline-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 200ms ease;
  }
  .backlink:hover,
  .inline-link:hover { border-color: currentColor; }

  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }

  /* Visually hidden but still focusable — display:none would take the radios
     out of the tab order and lose keyboard filtering entirely. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── the roster, doubling as the filter ─────────────────────────── */
  .roster {
    font-size: clamp(1.25rem, 3.2vw, 2.125rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-rule);
    padding: 1.5rem 0 2.5rem;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .roster { padding: 2rem 0 3.5rem; }
  }

  .roster label {
    color: var(--color-faint);
    cursor: pointer;
    transition: color 180ms ease;
    /* The comma belongs to the name before it. As a separate element it could
       wrap to the start of a line, which is where the stray leading commas
       came from. */
    white-space: nowrap;
  }
  .roster label:not(:last-child)::after {
    content: ',';
    color: var(--color-rule);
    margin-right: 0.3em;
  }
  .roster label:hover { color: var(--color-ink); }

  /* "All" is the state on load, so it starts lit. A later :checked rule for a
     client overrides this by source order. */
  #f-all:checked ~ .roster label[for='f-all'] { color: var(--color-ink); }
  #f-all:focus-visible ~ .roster label[for='f-all'] {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .roster__n {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.34em;
    vertical-align: super;
    letter-spacing: 0;
    margin-left: 0.15em;
    opacity: 0.75;
  }

  /* ── the index ──────────────────────────────────────────────────── */
  .index {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    grid-auto-rows: 140px;
    /* Feature tiles leave holes as the grid reflows and as filters change what
       is present; dense backfills them with whatever comes next. */
    grid-auto-flow: dense;
    gap: 0.75rem;
    list-style: none;
    padding: 0 0 3.5rem;
    margin: 0;
  }
  @media (min-width: 768px) {
    .index {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      grid-auto-rows: 180px;
      gap: 1rem;
    }
  }

  .piece {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .piece--feature {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* Contained, not cropped. These are adverts: a cell that crops fills the grid
     neatly and cuts every headline in half, which is the one thing the work
     cannot survive. */
  .piece__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    transition:
      transform 400ms cubic-bezier(0.2, 0.7, 0.3, 1),
      opacity 250ms ease;
  }

  /* Captions would be 24 blocks of grey text fighting 24 images, so they wait
     for intent. Alt text carries the same words for anyone not hovering. */
  .piece__label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.5rem 0.55rem 0.45rem;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--color-bg, #f2efe9);
    background: linear-gradient(to top, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 220ms ease, transform 220ms ease;
    pointer-events: none;
  }
  .piece__label b { display: block; font-weight: 600; }

  .piece:hover .piece__img { transform: scale(1.03); }
  .piece:hover .piece__label,
  .piece:focus-within .piece__label {
    opacity: 1;
    transform: none;
  }

  /* Touch has no hover, so the label would never appear. Show it there. */
  @media (hover: none) {
    .piece__label { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .piece__img,
    .piece__label,
    .piece:hover .piece__img {
      transition: none;
      transform: none;
    }
  }
</style>
