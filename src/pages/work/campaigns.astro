---
/**
 * The advertising index.
 *
 * This was twelve stacked sections, one per client, each a heading over a grid.
 * The repetition was structural rather than cosmetic: twelve identical blocks
 * read as an archive however they are styled, and they gave a one-off
 * restaurant ad exactly the same billing as a GTBank campaign.
 *
 * So the sections are gone. One grid holds every piece, and the client roster is
 * promoted into the headline as the filter. That removes the repetition at its
 * source and puts the actual selling point where it can be read in one glance —
 * GTBank, MTN, Sterling, KFC in a line beats twelve headings you scroll past.
 *
 * Filtering is CSS only. A radio per client sits before the grid, and generated
 * `:checked ~` rules hide the pieces that do not match. No JavaScript, so it
 * works on first paint and cannot break; the radios keep it keyboard-operable
 * and announce as a group.
 *
 * Nothing here has a brief behind it, so there is no honest problem-and-outcome
 * story to write for a Valentine's post. The work is the argument.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { Image, getImage } from 'astro:assets';
import { CAMPAIGNS } from '../../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

/**
 * The tilt of each piece on the board, derived from its filename.
 *
 * Seeded rather than random on purpose: a random angle is re-rolled on every
 * render, so the whole wall would reshuffle between builds and between a page
 * and its own reload. From the filename it is stable forever, and a piece keeps
 * its angle when the set around it is filtered.
 */
const hash = (str: string) => {
  let h = 2166136261;
  for (let i = 0; i < str.length; i += 1) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
};
/** Spread over a range, to 2dp, avoiding a dead-centre 0 that reads as unset. */
const spread = (str: string, range: number) =>
  Number((((hash(str) % 2000) / 1000 - 1) * range).toFixed(2));

const pieces = CAMPAIGNS.map((c) => {
  const hit = Object.keys(files).find((k) => k.endsWith(`/${c.image}`));
  return {
    ...c,
    id: slug(c.client),
    img: hit ? files[hit].default : undefined,
    rot: spread(c.image, 4.2),
    dy: spread(`${c.image}y`, 14),
  };
});

/** Roster in first-appearance order, which is already most-recognised first. */
const clients: { id: string; name: string; count: number }[] = [];
for (const p of pieces) {
  const found = clients.find((c) => c.id === p.id);
  if (found) found.count += 1;
  else clients.push({ id: p.id, name: p.client, count: 1 });
}

/**
 * Viewer artwork, resolved at build time but not attached until it is needed.
 *
 * These used to be <Image loading="lazy"> inside the closed dialog, on the
 * assumption that a hidden image is not fetched. It is not true: lazy loading
 * defers on viewport proximity, and an element in a display:none subtree has no
 * intersection to measure, so browsers fetch it immediately. All 24 stage
 * images and all 24 thumbnails were being pulled on every page load for a
 * dialog most visitors never open — 72 image requests for a page that shows 24.
 *
 * So the URLs are computed here and parked in data attributes; the script
 * promotes them to src/srcset the first time a slide is shown, and warms the
 * two either side of it.
 */
const shots = await Promise.all(
  pieces.map((p) =>
    p.img
      ? getImage({ src: p.img, widths: [600, 900, 1400], format: 'webp' })
      : null,
  ),
);
const thumbShots = await Promise.all(
  pieces.map((p) => (p.img ? getImage({ src: p.img, widths: [120, 240], format: 'webp' }) : null)),
);

/**
 * The filter rules, written out rather than scripted. One `:checked` selector
 * per client hides everything else, and a second lights its own label. Emitted
 * as a plain <style> so the generated selectors survive — Astro's scoping
 * rewrites authored CSS only.
 */
const filterCss = clients
  .map(
    ({ id }) => `
#f-${id}:checked ~ .index .piece:not([data-client='${id}']) { display: none; }
#f-${id}:checked ~ .roster label[for='f-${id}'] { color: var(--color-ink); }
#f-${id}:focus-visible ~ .roster label[for='f-${id}'] { outline: 2px solid var(--color-accent); outline-offset: 3px; }`,
  )
  .join('\n');
---

<Base
  title="Campaigns"
  description={`Print, social and digital advertising from Ojú — ${pieces.length} pieces across ${clients.length} brands.`}
>
  <SiteHeader current="/work" />
  <main id="main">
    <section class="rule-t gutter pt-12 pb-8 md:pt-16 md:pb-10">
      <p class="label mb-4">
        <a href="/work" class="backlink">Work</a> <span aria-hidden="true">/</span> Campaigns
      </p>
      <h1 class="font-display max-w-4xl text-[40px] leading-[1.05] tracking-tight md:text-[68px]">
        Print, social<br />and digital ads
      </h1>
      <p class="mt-6 max-w-lg text-soft">
        {pieces.length} pieces across {clients.length} names, for banks, telcos and
        restaurant brands. The craft side of the studio, shown without commentary.
      </p>
    </section>

    <form class="filter gutter">
      <fieldset>
        <legend class="sr-only">Filter campaigns by client</legend>

        <input class="sr-only" type="radio" name="client" id="f-all" checked />
        {clients.map((c) => <input class="sr-only" type="radio" name="client" id={`f-${c.id}`} />)}

        {/* The roster is the headline. Set at display size, muted until chosen. */}
        <div class="roster font-display">
          <label for="f-all">All</label>{' '}{
            /* The space between labels is load-bearing: it is the only line-break
               opportunity between them, and without it the roster runs off the
               page as one 2,488px line instead of wrapping. */
            clients.map((c) => (
              <>
                <label for={`f-${c.id}`}>{c.name}<sup class="roster__n">{c.count}</sup></label>{' '}
              </>
            ))
          }
        </div>

        <ul class="index">
          {
            pieces.map((p, i) => (
              <li
                class:list={['piece', p.feature && 'piece--feature']}
                data-client={p.id}
                style={`--rot:${p.rot}deg; --dy:${p.dy}px`}
              >
                {p.img && (
                  <button type="button" class="piece__open" data-open={i} aria-label={`View ${p.client}: ${p.caption}`}>
                    <Image
                      src={p.img}
                      alt=""
                      widths={[300, 600, 900]}
                      sizes="(min-width: 1024px) 24vw, (min-width: 640px) 32vw, 46vw"
                      loading="lazy"
                      decoding="async"
                      class="piece__img"
                    />
                  </button>
                )}
                <span class="piece__label" aria-hidden="true">
                  <b>{p.client}</b> {p.caption}
                </span>
              </li>
            ))
          }
        </ul>
      </fieldset>
    </form>

    {/* The viewer. A native <dialog> opened with showModal(), which brings Esc,
        a focus trap, an inert background and a ::backdrop with it — all things
        that are tedious and easy to get wrong by hand. */}
    <dialog class="lb" aria-label="Campaign viewer">
      <div class="lb__bar">
        <p class="lb__counter font-mono">
          <span class="lb__n" data-lb-index>1</span>
          <span class="lb__of"> / {pieces.length}</span>
          <span class="lb__sep" aria-hidden="true"> · </span>
          <span data-lb-client />
        </p>
        <div class="lb__baractions">
          <p class="lb__hint font-mono">Esc to close</p>
          <button type="button" class="lb__btn" data-lb-close aria-label="Close viewer">
            <svg viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <path d="M1 1 L14 14 M14 1 L1 14" />
            </svg>
          </button>
        </div>
      </div>

      <div class="lb__stage">
        <button type="button" class="lb__btn lb__btn--nav" data-lb-prev aria-label="Previous piece">
          <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M10.5 2 L4 8.5 L10.5 15" />
          </svg>
        </button>

        <div class="lb__frame">
          {
            pieces.map((p, i) =>
              shots[i] && p.img ? (
                <img
                  class="lb__img"
                  alt={`${p.client} — ${p.caption}`}
                  width={p.img.width}
                  height={p.img.height}
                  sizes="(min-width: 1024px) 60vw, 92vw"
                  decoding="async"
                  data-lb-slide={i}
                  data-src={shots[i]!.src}
                  data-srcset={shots[i]!.srcSet.attribute}
                  data-caption={p.caption}
                  data-client-name={p.client}
                  hidden
                />
              ) : null,
            )
          }
        </div>

        <button type="button" class="lb__btn lb__btn--nav" data-lb-next aria-label="Next piece">
          <svg viewBox="0 0 17 17" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M6.5 2 L13 8.5 L6.5 15" />
          </svg>
        </button>
      </div>

      <div class="lb__meta">
        <p class="lb__caption" data-lb-caption />
        <p class="lb__source font-mono" data-lb-source />
      </div>

      <div class="lb__strip" role="group" aria-label="Jump to a piece">
        {
          pieces.map((p, i) =>
            thumbShots[i] ? (
              <button type="button" class="lb__thumb" data-lb-goto={i} aria-label={`${p.client}: ${p.caption}`}>
                <img alt="" decoding="async" data-src={thumbShots[i]!.src} data-srcset={thumbShots[i]!.srcSet.attribute} sizes="72px" />
              </button>
            ) : null,
          )
        }
      </div>
    </dialog>

    <section class="rule-t gutter py-14 md:py-20">
      <p class="max-w-xl text-soft">
        The projects with a story behind them are on
        <a href="/work" class="inline-link">the work page</a>.
      </p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style is:global set:html={filterCss}></style>

<style>
  .backlink,
  .inline-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 200ms ease;
  }
  .backlink:hover,
  .inline-link:hover { border-color: currentColor; }

  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }

  /* Visually hidden but still focusable — display:none would take the radios
     out of the tab order and lose keyboard filtering entirely. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── the roster, doubling as the filter ─────────────────────────── */
  .roster {
    font-size: clamp(1.25rem, 3.2vw, 2.125rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-rule);
    padding: 1.5rem 0 2.5rem;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .roster { padding: 2rem 0 3.5rem; }
  }

  .roster label {
    color: var(--color-faint);
    cursor: pointer;
    transition: color 180ms ease;
    /* The comma belongs to the name before it. As a separate element it could
       wrap to the start of a line, which is where the stray leading commas
       came from. */
    white-space: nowrap;
  }
  .roster label:not(:last-child)::after {
    content: ',';
    color: var(--color-rule);
    margin-right: 0.3em;
  }
  .roster label:hover { color: var(--color-ink); }

  /* "All" is the state on load, so it starts lit. A later :checked rule for a
     client overrides this by source order. */
  #f-all:checked ~ .roster label[for='f-all'] { color: var(--color-ink); }
  #f-all:focus-visible ~ .roster label[for='f-all'] {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .roster__n {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.34em;
    vertical-align: super;
    letter-spacing: 0;
    margin-left: 0.15em;
    opacity: 0.75;
  }

  /* ── the board ──────────────────────────────────────────────────
     Columns rather than a grid. A grid of equal cells has to letterbox or crop
     to fill them; on a board the pieces keep their own size and the varying
     heights are the point — that is what stops it reading as a contact sheet.

     Transforms do not affect layout, so the tilt and the overlap are purely
     visual. The columns underneath stay orderly, which is what lets the filter
     hide a piece and have the rest simply close up rather than leave a hole in
     a collage. */
  .index {
    columns: 2;
    column-gap: 1.25rem;
    list-style: none;
    padding: 0 0 4rem;
    margin: 0;
  }
  @media (min-width: 640px) {
    .index { columns: 3; column-gap: 1.75rem; }
  }
  @media (min-width: 1024px) {
    .index { columns: 4; column-gap: 2.25rem; }
  }

  .piece {
    position: relative;
    /* Without this a piece can be split down a column boundary. */
    break-inside: avoid;
    margin-bottom: 2.25rem;
    transform: rotate(var(--rot, 0deg)) translateY(var(--dy, 0px));
    transition: transform 380ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  @media (min-width: 640px) {
    .piece { margin-bottom: 3rem; }
  }

  /* The pieces that carry a campaign sit a little larger, so the board has a
     couple of anchors rather than 24 items of equal weight. */
  .piece--feature {
    --lift: 1.06;
  }

  .piece__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgb(23 22 15 / 0.1);
    border-radius: 2px;
    background: var(--color-fill);
    /* Two shadows: a tight one for the paper's own edge, a wide soft one for
       the distance it sits off the board. */
    box-shadow:
      0 2px 6px rgb(23 22 15 / 0.07),
      0 14px 34px rgb(23 22 15 / 0.06);
    transition: box-shadow 380ms ease, border-color 380ms ease;
  }

  /* Hover straightens the piece and lifts it clear of its neighbours. The
     straightening is what makes the board feel like paper rather than a set of
     rotated boxes — the tilt has to be undone, not merely scaled. */
  .piece:hover,
  .piece:focus-within {
    transform: rotate(0deg) scale(var(--lift, 1.045));
    z-index: 20;
  }
  .piece:hover .piece__img,
  .piece:focus-within .piece__img {
    border-color: rgb(23 22 15 / 0.18);
    box-shadow:
      0 8px 18px rgb(23 22 15 / 0.1),
      0 34px 70px rgb(23 22 15 / 0.16);
  }

  /* Sits under the piece rather than over it: these are adverts, and a caption
     laid across one covers the work it is describing. */
  .piece__label {
    position: absolute;
    inset: auto auto -1.75rem 0;
    width: 100%;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--color-faint);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 240ms ease, transform 240ms ease;
    pointer-events: none;
  }
  .piece__label b {
    color: var(--color-ink);
    font-weight: 600;
    margin-right: 0.35em;
  }

  .piece:hover .piece__label,
  .piece:focus-within .piece__label {
    opacity: 1;
    transform: none;
  }

  /* Touch has no hover, so the caption would never appear. It is shown there,
     and the piece is given the room it needs underneath. */
  @media (hover: none) {
    .piece__label { opacity: 1; transform: none; }
    .piece { margin-bottom: 3.25rem; }
  }


  /* ── the piece as a trigger ─────────────────────────────────────── */
  .piece__open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  /* The straighten already keys off :focus-within, so a keyboard user gets the
     same lift as the mouse without another rule. */
  .piece__open:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  /* ── the viewer ─────────────────────────────────────────────────── */
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    /* Transparent, so the scrim is the ::backdrop and the board stays legible
       through it — the viewer reads as a layer over the page rather than a
       different place, which is what makes closing it feel like stepping back
       rather than navigating. */
    background: transparent;
    color: var(--color-paper);
    overflow: hidden;
  }
  .lb::backdrop {
    background: rgb(23 22 15 / 0.82);
    /* A little blur so the artwork separates from a board that is itself busy
       and colourful. Cheap at this radius, and it degrades to plain dimming
       wherever it is unsupported. */
    backdrop-filter: blur(4px) saturate(0.85);
    -webkit-backdrop-filter: blur(4px) saturate(0.85);
  }
  .lb:not([open]) { display: none; }

  .lb__bar {
    position: absolute;
    inset: 0 0 auto 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    z-index: 3;
  }
  @media (min-width: 768px) {
    .lb__bar { padding: 1.5rem 2rem; }
  }

  .lb__counter {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 239 233 / 0.62);
  }
  .lb__n { color: var(--color-paper); }

  .lb__baractions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lb__hint {
    display: none;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 239 233 / 0.42);
  }
  @media (min-width: 768px) {
    .lb__hint { display: block; }
  }

  .lb__btn {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgb(242 239 233 / 0.22);
    border-radius: 50%;
    background: none;
    color: var(--color-paper);
    cursor: pointer;
    transition: border-color 200ms ease, background 200ms ease;
  }
  @media (min-width: 768px) {
    .lb__btn { width: 56px; height: 56px; }
  }
  .lb__btn svg { width: 15px; height: 15px; }
  .lb__btn:hover { border-color: rgb(242 239 233 / 0.55); }
  .lb__btn:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }

  .lb__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 4.5rem 0.75rem 8.5rem;
  }
  @media (min-width: 768px) {
    .lb__stage { gap: 2.75rem; padding: 6rem 2rem 9.5rem; }
  }

  /* The arrows sit outside the artwork rather than over it, so a mis-tap moves
     the set instead of dismissing it. */
  .lb__btn--nav { z-index: 2; }

  /* On a phone two 44px arrows flanking the frame take 88px of 375, and the
     artwork ends up width-starved with empty bands above and below it. Below
     the breakpoint they drop out of the row and flank the caption instead, so
     the piece gets the full width and still nobody taps an arrow by accident. */
  @media (max-width: 767px) {
    .lb__btn--nav {
      position: absolute;
      bottom: 5.5rem;
    }
    .lb__stage > .lb__btn--nav:first-child { left: 0.75rem; }
    .lb__stage > .lb__btn--nav:last-child { right: 0.75rem; }
  }

  .lb__frame {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  /* Every slide sits in the one cell. The current one is opaque and centred;
     the rest are only ever mid-transition. `hidden` still does the hiding at
     rest, which is what keeps the other 23 images from loading. */
  .lb__img {
    grid-area: 1 / 1;
    opacity: 0;
    transition:
      opacity 280ms ease,
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1);
    max-width: 100%;
    /* Measured against the viewport, not the frame. A percentage height on a
       centred flex item does not resolve against the stage's padded box, so the
       artwork ran under the caption and off the bottom of the screen. These
       subtract the stage's own padding: 4.5 + 8.5 here, 6 + 9.5 wide. */
    max-height: calc(100dvh - 13rem);
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 40px 90px rgb(0 0 0 / 0.5);
  }
  .lb__img.is-current {
    opacity: 1;
    transform: none;
  }
  @media (min-width: 768px) {
    .lb__img { max-height: calc(100dvh - 15.5rem); }
  }

  .lb__meta {
    position: absolute;
    inset: auto 0 6.25rem 0;
    text-align: center;
    /* Clears the arrows, which sit in this band on a phone. */
    padding: 0 4.75rem;
    z-index: 2;
  }
  @media (min-width: 768px) {
    .lb__meta { padding: 0 1.5rem; }
  }
  .lb__caption {
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  @media (min-width: 768px) {
    .lb__caption { font-size: 1.0625rem; }
  }
  .lb__source {
    margin-top: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 239 233 / 0.55);
  }

  .lb__strip {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    z-index: 3;
  }
  .lb__strip::-webkit-scrollbar { display: none; }

  .lb__thumb {
    flex: none;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    line-height: 0;
    opacity: 0.4;
    transition: opacity 200ms ease;
  }
  .lb__thumb img {
    height: 40px;
    width: auto;
    border-radius: 2px;
  }
  @media (min-width: 768px) {
    .lb__thumb img { height: 44px; }
  }
  .lb__thumb:hover { opacity: 0.75; }
  .lb__thumb[aria-current='true'] {
    opacity: 1;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .lb__thumb:focus-visible {
    opacity: 1;
    outline: 2px solid var(--color-paper);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lb__btn,
    .lb__thumb,
    .lb__img { transition: none; }
  }

  /* The tilt is a static arrangement, not motion, so it stays. What goes is the
     movement between states. */
  @media (prefers-reduced-motion: reduce) {
    .piece,
    .piece__img,
    .piece__label {
      transition: none;
    }
    .piece:hover,
    .piece:focus-within {
      transform: rotate(var(--rot, 0deg)) translateY(var(--dy, 0px));
    }
  }
</style>

<script>
  /**
   * The campaign viewer.
   *
   * Built on a native <dialog> opened with showModal(), which supplies Esc,
   * a focus trap, an inert background and the backdrop. What is left is the
   * set: which piece is showing, and moving between them.
   *
   * Navigation follows the filter. With the roster set to one client the
   * arrows move through that client's pieces only — stepping into hidden work
   * would contradict what the page is showing.
   */
  const dialog = document.querySelector<HTMLDialogElement>('.lb');
  const slides = [...document.querySelectorAll<HTMLImageElement>('[data-lb-slide]')];

  if (dialog && slides.length) {
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>('[data-lb-goto]')];
    const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-open]')];
    const idxEl = dialog.querySelector<HTMLElement>('[data-lb-index]');
    const clientEl = dialog.querySelector<HTMLElement>('[data-lb-client]');
    const captionEl = dialog.querySelector<HTMLElement>('[data-lb-caption]');
    const sourceEl = dialog.querySelector<HTMLElement>('[data-lb-source]');
    const ofEl = dialog.querySelector<HTMLElement>('.lb__of');

    /** The piece that opened the viewer, so focus can go back to it. */
    let opener: HTMLElement | null = null;
    let index = -1;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    /** How far a slide travels as it enters or leaves. */
    const TRAVEL = 44;

    /**
     * Attach a parked URL. Nothing in the viewer carries a src until it is
     * wanted, because a hidden image is fetched like any other — see the note
     * in the frontmatter.
     */
    const attach = (img: HTMLImageElement | null | undefined) => {
      if (!img || img.getAttribute('src')) return;
      const { src, srcset } = img.dataset;
      if (srcset) img.setAttribute('srcset', srcset);
      if (src) img.setAttribute('src', src);
    };

    /** The one being shown, plus its neighbours so a step is not a blank beat. */
    const warm = (i: number) => {
      const set = active();
      const at = set.indexOf(i);
      [i, set[(at + 1) % set.length], set[(at - 1 + set.length) % set.length]].forEach((n) => {
        if (n !== undefined) attach(slides[n]);
      });
    };

    /**
     * Swap slides with a directional slide.
     *
     * `hidden` is display:none, which cannot transition and is also what keeps
     * the other 23 images from ever being fetched. So the incoming slide is
     * unhidden and placed at its start offset with transitions off, forced to
     * lay out, and only then released — and the outgoing one is hidden again
     * once it has finished leaving, restoring the cheap resting state.
     */
    const move = (from: HTMLImageElement | null, to: HTMLImageElement, dir: number) => {
      attach(to);
      to.hidden = false;

      if (dir === 0 || reduced.matches) {
        to.classList.add('is-current');
        if (from && from !== to) { from.classList.remove('is-current'); from.hidden = true; }
        return;
      }

      to.style.transition = 'none';
      to.style.transform = `translateX(${dir * TRAVEL}px)`;
      void to.offsetWidth; // commit the start position before animating from it
      to.style.transition = '';
      to.style.transform = '';
      to.classList.add('is-current');

      if (from && from !== to) {
        from.classList.remove('is-current');
        from.style.transform = `translateX(${-dir * TRAVEL}px)`;
        // Re-hiding waits for the exit. A transitionend can be missed if the
        // slide is swapped again mid-flight, so the timeout is the real
        // guarantee and the listener only makes it prompt.
        const settle = () => {
          if (from.classList.contains('is-current')) return; // came back
          from.hidden = true;
          from.style.transform = '';
        };
        from.addEventListener('transitionend', settle, { once: true });
        setTimeout(settle, 520);
      }
    };

    /** Indices the current filter leaves visible, in document order. */
    const active = () => {
      const list = openers
        .map((b, i) => ({ i, li: b.closest<HTMLElement>('.piece') }))
        .filter(({ li }) => li && getComputedStyle(li).display !== 'none')
        .map(({ i }) => i);
      return list.length ? list : openers.map((_, i) => i);
    };

    const show = (next: number, dir = 0) => {
      const from = index >= 0 ? slides[index] : null;
      index = next;
      move(from, slides[index], dir);
      warm(index);

      const current = slides[index];
      const client = current.dataset.clientName ?? '';
      const caption = current.dataset.caption ?? '';
      const set = active();
      const place = set.indexOf(index);

      if (idxEl) idxEl.textContent = String(place >= 0 ? place + 1 : 1);
      if (ofEl) ofEl.textContent = ` / ${set.length}`;
      if (clientEl) clientEl.textContent = client;
      if (captionEl) captionEl.textContent = caption;
      if (sourceEl) sourceEl.textContent = client;

      thumbs.forEach((t, i) => {
        t.setAttribute('aria-current', String(i === index));
        // A thumb for a filtered-out piece is not a place the arrows can reach,
        // so it should not be offered as a shortcut either.
        t.hidden = !set.includes(i);
      });
      thumbs[index]?.scrollIntoView({ block: 'nearest', inline: 'center' });
    };

    const step = (delta: number) => {
      const set = active();
      const at = set.indexOf(index);
      const at0 = at === -1 ? 0 : at;
      show(set[(at0 + delta + set.length) % set.length], delta > 0 ? 1 : -1);
    };

    const open = (i: number, from: HTMLElement) => {
      opener = from;
      // The filmstrip is only ever seen with the dialog open, so its thumbnails
      // wait until it is.
      thumbs.forEach((t) => attach(t.querySelector('img')));
      show(i);
      dialog.showModal();
    };

    openers.forEach((b, i) => b.addEventListener('click', () => open(i, b)));
    thumbs.forEach((t, i) => t.addEventListener('click', () => show(i, i > index ? 1 : -1)));

    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
    });

    /* Clicking the ground around the artwork closes. The dialog fills the
       viewport, so the backdrop never receives the click — the target is the
       dialog itself, or the stage padding around the frame. */
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.classList.contains('lb__stage') || t.classList.contains('lb__frame')) {
        dialog.close();
      }
    });

    /* Return focus to the piece that opened it, so a keyboard user lands back
       where they were rather than at the top of the board. */
    dialog.addEventListener('close', () => {
      opener?.focus();
      opener = null;
    });
  }
</script>
