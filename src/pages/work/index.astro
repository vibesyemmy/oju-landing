---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WorkIndex from '../../components/WorkIndex.astro';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);
---

<Base title="Work" description="Selected projects from Ojú — design, product and engineering.">
  <SiteHeader current="/work" />
  <main id="main">
    <section class="border-t border-rule px-6 py-14 md:px-20 md:py-22">
      <h1 class="font-display mb-10 text-[44px] leading-tight tracking-tight md:mb-16 md:text-[78px]">
        Selected work
      </h1>
      <WorkIndex entries={entries} />
    </section>
  </main>
  <SiteFooter />
</Base>
