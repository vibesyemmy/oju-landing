---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WorkGallery from '../../components/WorkGallery.astro';

---

<Base title="Work" description="Selected projects from Ojú: design, product and engineering.">
  <SiteHeader current="/work" />
  <main id="main">
    <WorkGallery />

    <section class="rule-t gutter py-14 md:py-20">
      <div class="md:flex md:items-end md:justify-between md:gap-10">
        <div class="max-w-xl">
          <p class="label mb-4">Campaigns</p>
          <h2 class="font-display text-[32px] leading-tight tracking-tight md:text-[44px]">
            Print, social and digital ads
          </h2>
          <p class="mt-5 text-soft">
            Campaign work for banks, telcos and restaurant brands — the craft
            side of the studio, shown without commentary.
          </p>
        </div>
        <a href="/work/campaigns/" class="campaign-link">
          See the gallery <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .campaign-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    flex: none;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 3px;
    transition: border-color 200ms ease;
  }
  .campaign-link:hover { border-color: var(--color-ink); }
  @media (min-width: 768px) {
    .campaign-link { margin-top: 0; }
  }
</style>
