---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroStatement from '../components/hero/HeroStatement.astro';
import WorkWall from '../components/WorkWall.astro';
import CapabilityMark from '../components/CapabilityMark.astro';
import ImpactCarousel from '../components/ImpactCarousel.astro';
import CampaignStrip from '../components/CampaignStrip.astro';
import Media from '../components/Media.astro';
import ClientMarquee from '../components/ClientMarquee.astro';
/* Standing in for a photograph of the room, which does not exist yet. Real work
   beats a stock office, and this is a page of the design system we shipped. */
import poseidonGrid from '../assets/wall/poseidon-grid.webp';
// Alternatives, one import swap away:
//   HeroEditorial — original left-aligned statement
//   HeroConverge  — converging-stream carousel
import { CAPABILITIES, SITE } from '../data/site';


---

<Base>
  <SiteHeader />

  <main id="main">
    <!-- HERO -->
    <HeroStatement />
    <WorkWall />

    <ClientMarquee />

    <!-- CAPABILITIES -->
    <section class="border-t border-rule px-6 py-14 md:px-20 md:py-22">
      <div class="mb-8 flex items-baseline justify-between gap-4 md:mb-13">
        <h2 class="label">What we do</h2>
        <a href="/services" class="caps__all font-mono">
          All services <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid gap-4 md:grid-cols-3 md:gap-5">
        {
          /* The aria-label matters: without it each link's accessible name is
             the entire card — heading, lede and all five list items read aloud
             as one run-on string. */
          CAPABILITIES.map((cap) => (
            <a class="cap" href={`/services#${cap.id}`} aria-label={`${cap.title}: what this covers`}>
              <CapabilityMark kind={cap.id as 'design' | 'product' | 'engineering'} />

              <h3 class="cap__head">
                <span class="font-mono text-[11px] text-accent">{cap.num}</span>
                <span class="font-display text-[26px] tracking-tight md:text-[30px]">{cap.title}</span>
              </h3>

              <p class="cap__lede text-pretty">{cap.line}</p>

              <ul class="cap__items">
                {cap.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>

              <span class="cap__go font-mono" aria-hidden="true">
                <span>What this covers</span>
                <span class="cap__arrow">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <ImpactCarousel />

    <CampaignStrip />

    <!-- STUDIO -->
    <section class="border-t border-rule px-6 py-14 md:px-20 md:py-22">
      <div class="grid gap-8 md:grid-cols-[1.15fr_1fr] md:gap-22">
        <div>
          <h2 class="label mb-7 md:mb-11">Studio</h2>
          <p class="font-display mb-6 text-[30px] leading-snug tracking-tight text-pretty md:mb-8 md:text-[42px]">
            <span lang="yo">Ojú</span> means <em>face</em> in Yoruba.
            <span lang="yo" class="whitespace-nowrap">Ojú-ìwé</span> means <em>page</em>.
          </p>
          <p class="max-w-[500px] text-base leading-relaxed text-soft text-pretty md:text-[18px]">
            An interface is the face of a system. We design the face and build the system behind it
            as one thing, because that seam is where products come apart.
          </p>
        </div>
        <Media
          label="The team, or the room. Something that proves there are people here."
          src={poseidonGrid}
          alt="A page of the Poseidon design system: components and tokens laid out in a grid."
          ratio="4/3"
          size="1600×1200"
          sizes="(max-width: 767px) 100vw, 42vw"
        />
      </div>
    </section>

    <!-- CONTACT -->
    <section class="border-t border-rule px-6 py-16 md:px-20 md:py-28">
      <h2 class="font-display max-w-[1000px] text-[44px] leading-[1.04] tracking-[-0.022em] md:text-[88px] md:leading-[1.02] md:tracking-[-0.028em]">
        Have something worth building?
      </h2>
      <div class="mt-9 flex flex-col items-start gap-7 md:mt-16 md:flex-row md:items-end md:justify-between md:gap-16">
        <a href="/contact" class="cta">
          <span class="text-base md:text-[17px]">Start a project</span>
          <span class="font-mono text-[15px]" aria-hidden="true">→</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="font-mono text-[13px] text-soft hover:text-ink md:text-sm">
          {SITE.email}
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
