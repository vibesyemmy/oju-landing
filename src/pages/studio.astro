---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
/* Licensed stock, standing in until the real room and street are photographed.
   Pexels licence, free for commercial use.
     studio-room   — Skylar Kang, pexels.com/photo/6044844
     lagos-theatre — Paul Uchechukwu, pexels.com/photo/38327849 */
import studioRoom from '../assets/studio/studio-room.webp';
import lagosTheatre from '../assets/studio/lagos-theatre.webp';
import { PRINCIPLES, STUDIO_FACTS, TEAM } from '../data/site';

/* Portraits resolve by filename rather than by static import, so a member whose
   photo has not landed yet still renders — the Media brief stands in for it. */
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/team/*.{webp,avif,jpg,jpeg,png}',
  { eager: true },
);
const portraitFor = (file?: string) =>
  file ? portraits[`../assets/team/${file}`]?.default : undefined;

/*
 * The phone-sized pan lands on one card at a time, which means one keyframe per
 * card — a count only the data knows. Each card holds the leading edge for the
 * first part of its turn, then glides to the next, so the movement is watched
 * rather than jumped through. Segments ease individually (see the mobile rule
 * in the stylesheet); the holds are pairs of identical stops, so easing across
 * them changes nothing.
 */
const SNAP_HOLD = 0.55;
const teamSnapKeyframes = (() => {
  const moves = TEAM.length - 1;
  if (moves < 1) return '';
  const stops: string[] = [];
  for (let i = 0; i < moves; i++) {
    const from = ((i / moves) * 100).toFixed(3);
    const held = (((i + SNAP_HOLD) / moves) * 100).toFixed(3);
    stops.push(`${from}%,${held}%{transform:translateX(calc(${-i} * var(--step)))}`);
  }
  stops.push(`100%{transform:translateX(calc(${-moves} * var(--step)))}`);
  return `@keyframes team-pan-snap{${stops.join('')}}`;
})();
---

<Base
  title="Studio"
  description="Ojú is a design and product studio in Lagos. Who we are, how we work, and why one team holds both crafts."
>
  <SiteHeader current="/studio" />

  <main id="main">
    <PageHero
      label="Studio"
      title="An interface is a face."
      lede="The name is the argument: the interface is the only part of a system a person ever meets, and it cannot be separated from what runs underneath it."
    />

    <section class="gutter pb-12 md:pb-20">
      <Media
        label="The studio at work: the room, the wall, people mid-argument over a screen. Not a stock office."
        src={studioRoom}
        alt="Desks, screens and drawn curtains in a working studio."
        ratio="21/9"
        size="2400×1029"
        loading="eager"
        sizes="(max-width: 768px) 100vw, 90vw"
      />
    </section>

    <!-- THE NAME -->
    <section class="rule-t gutter py-12 md:py-20">
      <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:gap-24">
        <h2 class="label">The name</h2>
        <div class="flex max-w-[62ch] flex-col gap-6 text-[17px] leading-relaxed text-soft text-pretty md:text-[19px]">
          <p>
            <span lang="yo" class="text-ink">Ojú</span> is Yoruba for face, and for eye.
            <span lang="yo" class="whitespace-nowrap text-ink">Ojú-ìwé</span>, literally
            face-of-the-leaf, is how you say page.
          </p>
          <p>
            We liked that a language already had a word for the thing our industry
            calls an interface, and that the word is about being seen rather than
            about screens. A face is not decoration on top of a person. It is how
            you know who you are dealing with.
          </p>
          <p>
            That is the whole studio in one word: the surface and the thing beneath
            it are not separate jobs.
          </p>
        </div>
      </div>
    </section>

    <!-- PRINCIPLES -->
    <section class="rule-t gutter py-12 md:py-20">
      <h2 class="label mb-9 md:mb-14">How we work</h2>
      <div class="grid gap-10 md:grid-cols-2 md:gap-x-24 md:gap-y-14">
        {
          PRINCIPLES.map((p, i) => (
            <div class="border-t border-ink pt-5">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-[11px] text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="font-display text-[24px] tracking-tight md:text-[28px]">{p.title}</h3>
              </div>
              <p class="mt-4 max-w-[52ch] text-[16px] leading-relaxed text-soft text-pretty">
                {p.body}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FACTS + PHOTO -->
    <section class="rule-t gutter py-12 md:py-20">
      <div class="grid gap-10 md:grid-cols-[1fr_1.15fr] md:gap-24">
        <div>
          <h2 class="label mb-8">The facts</h2>
          <dl>
            {
              /* An empty value means the fact does not apply — drop the row rather
                 than rendering a label with nothing beside it. */
              STUDIO_FACTS.filter((f) => f.v).map((f) => (
                <div class="flex justify-between gap-6 border-b border-rule py-4">
                  <dt class="label whitespace-nowrap">{f.k}</dt>
                  <dd class="text-right font-mono text-[13px] text-ink">{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        <Media
          label="Somewhere that says Lagos without captioning it: the street, the building, the view from the desk."
          src={lagosTheatre}
          alt="The National Arts Theatre in Lagos, mirrored in the water in front of it."
          ratio="4/3"
          size="1600×1200"
          sizes="(max-width: 767px) 100vw, 48vw"
        />
      </div>
    </section>

    <!-- TEAM -->
    {
      TEAM.length > 0 && (
        <section
          class="team rule-t gutter py-12 md:py-20"
          style={`--count:${TEAM.length}`}
        >
          <div class="team__stage">
            <div class="team__pin">
              <h2 class="label mb-9 md:mb-14">The team</h2>
              <div class="team__viewport">
                <ul class="team__track" tabindex="0" aria-label="The team, scrollable">
            {TEAM.map((m) => (
              <li class="team__card">
                <Media
                  label={`${m.name}: portrait`}
                  src={portraitFor(m.portrait)}
                  alt={`${m.name}, ${m.role}`}
                  ratio="1/1"
                  size="800×800"
                  widths={[400, 640, 800]}
                  sizes="(max-width: 767px) 78vw, 460px"
                  class="mb-6"
                />
                <p
                  class:list={[
                    'font-display text-[24px] leading-tight tracking-tight md:text-[26px]',
                    /* A seat awaiting its person reads as a gap, not as someone. */
                    m.pending && 'text-faint',
                  ]}
                >
                  {m.name}
                </p>
                <p class="mt-2 font-mono text-[12.5px] leading-relaxed text-faint">{m.role}</p>
                <p
                  class:list={[
                    'mt-4 text-[15.5px] leading-relaxed text-pretty md:text-[16px]',
                    m.pending ? 'text-faint' : 'text-soft',
                  ]}
                >
                  {m.summary}
                </p>
              </li>
            ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA -->
    <section class="rule-t gutter py-16 md:py-28">
      <h2 class="font-display max-w-[18ch] text-[40px] leading-[1.04] tracking-[-0.024em] md:text-[72px] md:tracking-[-0.028em]">
        Want to see how we would approach yours?
      </h2>
      <div class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-10">
        <a href="/contact" class="cta">
          <span class="text-base md:text-[17px]">Start a project</span>
          <span class="font-mono text-[15px]" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/work" class="cta cta--quiet">
          <span class="text-base md:text-[17px]">See the work</span>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /*
   * The section holds still while the row walks sideways, then releases and the
   * page carries on. Mechanically: the stage is a viewport taller than the pin
   * inside it, the pin sticks, and the row is panned by the stage's own
   * view timeline over its `contain` range — the exact window during which a
   * subject taller than the screen is covering it, which is the same window the
   * pin is stuck for. So the pan starts and ends with the pin, by construction
   * rather than by tuning.
   *
   * All of it is CSS. No scroll listener, no scrolljacking library, and nothing
   * that can leave the page stranded if a frame is missed.
   */
  .team {
    /* Card and gap are fixed, so the travel is arithmetic rather than a
       measurement. --count comes from the data: adding a member lengthens both
       the pan and the stage that drives it, with nothing to keep in sync. */
    --card-w: min(78vw, 340px);
    --gap: 2rem;
    /* The section's own horizontal padding, both sides. */
    --edge: 3rem;
    --track-w: calc(var(--count) * var(--card-w) + (var(--count) - 1) * var(--gap));
    /* One card plus the gap after it — the distance from a card to the next. */
    --step: calc(var(--card-w) + var(--gap));
    /*
     * The space the row actually has. Past 1440px the gutter grows instead of
     * the content, so the column stops at --content-max — measuring from the
     * viewport alone would have the row believing in width it never gets, and
     * the last card would sit clipped in the margin with no pan to reach it.
     */
    --avail: min(calc(100vw - var(--edge)), var(--content-max));
    /* Zero when the row already fits — a short team pins nothing and pans
       nothing, because the stage is then exactly as tall as the pin. */
    --pan-abs: max(0px, calc(var(--track-w) - var(--avail)));
  }

  /*
   * On a phone a card is nearly the whole screen, so a continuous pan leaves
   * the reader looking at two half cards for most of the scroll. Below the
   * breakpoint the row moves a card at a time instead: it travels far enough to
   * bring the last card to the leading edge, and holds each card there for its
   * share of the scroll (see the stepped timing function further down).
   */
  @media (max-width: 767px) {
    .team {
      --pan-abs: calc((var(--count) - 1) * var(--step));
    }
  }

  @media (min-width: 768px) {
    .team {
      /* Grows with the screen, so a wide desktop gets bigger cards rather than
         a row that fits with room to spare — which would leave the section
         pinned for a pan of zero. Height has a vote too: the card is pinned
         against a whole screen, so a wide but short window must not be handed
         a card taller than it. */
      --card-w: clamp(340px, min(24vw, 52vh), 460px);
      --gap: 3rem;
      --edge: 10rem;
    }
  }

  .team__viewport {
    /* clip, not hidden: hidden would make this a scroll container and fight the
       pan. Cards slide in and out at the section's padding edge. */
    overflow-x: clip;
  }

  .team__track {
    display: flex;
    gap: var(--gap);
    /* The fallback wherever the pan does not run: an ordinary swipeable row. */
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
  }

  .team__card {
    flex: 0 0 auto;
    width: var(--card-w);
    scroll-snap-align: start;
  }

  @supports (animation-timeline: view()) {
    /* A pin only works while the card fits the screen it is pinned to. Below
       that the section stays an ordinary scrollable row rather than clipping
       its own content. */
    @media (prefers-reduced-motion: no-preference) and (min-height: 620px) {
      .team__stage {
        view-timeline-name: --team-stage;
        view-timeline-axis: block;
        /* One screen to hold, plus exactly the distance the row must travel. */
        height: calc(100svh + var(--pan-abs));
      }

      .team__pin {
        position: sticky;
        top: 0;
        height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .team__track {
        /* The pan replaces manual scrolling, so the two cannot disagree. */
        overflow-x: visible;
        animation: team-pan linear both;
        animation-timeline: --team-stage;
        animation-range: contain 0% contain 100%;
      }

      @media (max-width: 767px) {
        .team__track {
          /* Card-at-a-time, but travelled rather than cut to: the keyframes
             hold each card and then glide to the next, and ease-in-out applies
             to each of those segments in turn. */
          animation-name: team-pan-snap;
          animation-timing-function: ease-in-out;
        }
      }
    }
  }

  @keyframes team-pan {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--pan-abs)));
    }
  }
</style>

<style is:inline set:html={teamSnapKeyframes} />
