---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE } from '../../data/site';
---

<Base title="That did not send" description="The enquiry form could not be delivered.">
  <SiteHeader current="/contact" />
  <main id="main">
    <PageHero
      label="Contact"
      title="That did not send."
      lede="Something on our end failed, or a required field was missing. Nothing was lost on your side — go back and try again, or skip the form entirely and email us."
    />
    <section class="border-t border-rule px-6 py-12 md:px-20 md:py-20">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-10">
        <a href="/contact" class="cta">
          <span class="text-base md:text-[17px]">Back to the form</span>
          <span class="font-mono text-[15px]" aria-hidden="true">&rarr;</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="font-mono text-[13px] text-soft hover:text-ink md:text-sm">
          {SITE.email}
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
