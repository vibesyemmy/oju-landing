---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
/* Licensed stock, standing in until real artefacts can be exported from the
   projects themselves. Pexels licence, free for commercial use.
     design      — Md Mahdi, pexels.com/photo/36747234
     product     — Bruno Scramgnon, pexels.com/photo/12797275
     engineering — Markus Spiske, pexels.com/photo/159299 */
import designShot from '../assets/services/design.webp';
import productShot from '../assets/services/product.webp';
import engineeringShot from '../assets/services/engineering.webp';

/* Keyed by service id, so a service without a picture simply keeps its brief. */
const MEDIA: Record<string, { src: ImageMetadata; alt: string }> = {
  design: {
    src: designShot,
    alt: 'A designer laying out app screens on a large monitor.',
  },
  product: {
    src: productShot,
    alt: 'A wall covered edge to edge in handwritten notes.',
  },
  engineering: {
    src: engineeringShot,
    alt: 'Stylesheet code open across two monitors in a dark room.',
  },
};
import { SERVICES, ENGAGEMENTS, PROCESS, SITE } from '../data/site';
---

<Base
  title="Services"
  description="Design, product and engineering from one team. What Ojú does, what you get, and how the work is structured."
>
  <SiteHeader current="/services" />

  <main id="main">
    <PageHero
      label="Services"
      title="Three disciplines, one team, one invoice."
      lede="Most studios do the drawing and hand the rest to somebody else. We keep the whole thing, because the handover is where products go wrong."
    />

    {
      SERVICES.map((s) => (
        <section id={s.id} class="border-t border-rule gutter py-12 md:py-20">
          <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-24">
            <div>
              <h2 class="flex items-baseline gap-3 border-b border-ink pb-4">
                <span class="font-mono text-[11px] text-accent">{s.num}</span>
                <span class="font-display text-[30px] tracking-tight md:text-[38px]">{s.title}</span>
              </h2>

              {/* Under the title rather than below the lists: the title column is
                  otherwise empty for the height of the section, and the picture
                  fills it instead of adding to the page. */}
              <Media
                label={s.media.label}
                kind={MEDIA[s.id] ? 'image' : s.media.kind}
                src={MEDIA[s.id]?.src}
                alt={MEDIA[s.id]?.alt}
                ratio={s.media.ratio}
                size={s.media.size}
                sizes="(max-width: 1023px) 100vw, 28vw"
                class="mt-8 lg:mt-10"
              />
            </div>

            <div class="max-w-[62ch]">
              <p class="text-xl leading-snug text-pretty md:text-[26px]">{s.lede}</p>

              <div class="mt-10 grid gap-10 sm:grid-cols-2 md:mt-14">
                <div>
                  <h3 class="label mb-5">What it covers</h3>
                  <ul class="flex flex-col gap-3">
                    {s.includes.map((i) => (
                      <li class="font-mono text-[13px] leading-relaxed text-soft">{i}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="label mb-5">What you get</h3>
                  <ul class="flex flex-col gap-3">
                    {s.deliverables.map((d) => (
                      <li class="flex gap-2.5 text-[15px] leading-relaxed text-soft text-pretty">
                        <span class="mt-[7px] size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                        <span>{d}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- PROCESS -->
    <section class="border-t border-rule gutter py-12 md:py-20">
      <h2 class="label mb-9 md:mb-14">How the work runs</h2>
      <ol class="grid gap-10 sm:grid-cols-2 md:gap-12 xl:grid-cols-4">
        {
          PROCESS.map((p) => (
            <li class="border-t border-ink pt-5">
              <p class="font-mono text-[11px] text-accent">{p.num}</p>
              <h3 class="font-display mt-3 text-[26px] tracking-tight">{p.title}</h3>
              <p class="mt-4 text-[15px] leading-relaxed text-soft text-pretty">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ENGAGEMENTS -->
    <section class="border-t border-rule gutter py-12 md:py-20">
      <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-24">
        <h2 class="label">Ways to work together</h2>
        <div class="flex flex-col">
          {
            ENGAGEMENTS.map((e) => (
              <div class="grid gap-2 border-b border-rule py-7 last:border-b-0 lg:grid-cols-[1fr_2fr] lg:gap-10">
                <h3 class="font-display text-[24px] tracking-tight md:text-[28px]">{e.title}</h3>
                <div class="max-w-[52ch]">
                  <p class="text-[17px] leading-relaxed text-pretty">{e.lede}</p>
                  <p class="mt-2 font-mono text-[12.5px] leading-relaxed text-faint">{e.detail}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <p class="label mt-10 max-w-[60ch] leading-relaxed">
        Pricing depends on scope and shape. Tell us the problem and we will quote the work.
      </p>
    </section>

    <!-- CTA -->
    <section class="border-t border-rule gutter py-16 md:py-28">
      <h2 class="font-display max-w-[18ch] text-[40px] leading-[1.04] tracking-[-0.024em] md:text-[72px] md:tracking-[-0.028em]">
        Not sure which of these you need?
      </h2>
      <p class="mt-7 max-w-[46ch] text-lg leading-relaxed text-soft text-pretty">
        Most people are not, at the start. Describe the problem and we will tell you
        what the work actually is, even if the answer is that you do not need us.
      </p>
      <div class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-10">
        <a href="/contact" class="cta">
          <span class="text-base md:text-[17px]">Start a project</span>
          <span class="font-mono text-[15px]" aria-hidden="true">&rarr;</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="font-mono text-[13px] text-soft hover:text-ink md:text-sm">
          {SITE.email}
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
