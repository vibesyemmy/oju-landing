---
/**
 * A pixel fireball on the pointer, with a dithered wake behind the page.
 *
 * Two canvases, because the two want opposite stacking. The wake sits behind
 * everything so sections and images occlude it; the fireball is the pointer, so
 * it has to stay on top of whatever it is over. One canvas could not do both.
 *
 * The system cursor is left alone. Replacing it would cost the arrow, the text
 * beam and the pointer over links — a lot of usable signal for a decoration.
 *
 * Ordered dithering rather than a blur or a fade: each cell is either drawn or
 * not, decided by a 4×4 Bayer threshold, which is what gives the texture its
 * hard-edged, printed look instead of a soft smear. A wake that faded smoothly
 * would just be a glow.
 *
 * The fireball is not a sprite. It is a heat field sampled on the same 9px grid
 * as the wake, so the two are one material: a value-noise flame around a radial
 * falloff, banded into colours by heat and dissolved at the edge by the same
 * Bayer threshold. That is what stops it having a rim — the outside scatters
 * into loose cells instead of ending at an outline.
 *
 * The flame flows rather than boils. The noise is sampled from a fixed seed and
 * *translated* upward frame by frame, so the pattern rises like fire; a seed
 * that changed every frame would just be static. Two octaves drift at different
 * speeds, which is what makes it churn as it climbs.
 *
 * Shape advances on its own clock, near 11fps, while position updates every
 * frame. Stepped animation on smooth motion is what reads as pixel art; a flame
 * redrawn 60 times a second reads as noise.
 *
 * Behind the page, the wake reads as texture in the margins rather than as
 * something drawn over the work — and it settles what would otherwise clash
 * with the work gallery's own cursor, which is simply in front of it.
 *
 * Off entirely under prefers-reduced-motion and on touch — there is no pointer
 * to carry it.
 */
---

<canvas class="dither" data-dither aria-hidden="true"></canvas>
<canvas class="ember" data-ember aria-hidden="true"></canvas>

<style>
  .dither {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Behind the page. The paper ground moved from body to html so this can
       paint above it: a background on body would have covered the canvas
       outright at a negative index. */
    z-index: -1;
    pointer-events: none;
  }
  /* The pointer itself, so it goes over everything it passes. */
  .ember {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 60;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dither,
    .ember { display: none; }
  }
  @media (hover: none) {
    .dither,
    .ember { display: none; }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  const ember = document.querySelector<HTMLCanvasElement>('[data-ember]');

  if (canvas && ember && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const ectx = ember.getContext('2d', { alpha: true });

    /** Block size in CSS pixels: an 8px block in a 9px cell, wake and flame
        alike, so a cell of one lines up with a cell of the other. */
    const CELL = 9;
    /** How many pointer samples the wake remembers. */
    const TAIL = 16;
    /** Cells reachable from a wake sample, in cells. */
    const REACH = 3;

    /** Flame radius in cells, and how far past it a cell may still catch. */
    const CORE = 3.7;
    const SPAN = 7;
    /** One flame frame. ~11fps: stepped enough to read as drawn. */
    const FLAME_MS = 92;

    const WHITE = '#fffbe8';
    const YELLOW = '#ffe500';
    const ORANGE = '#ff8a1e';
    const RED = '#ff2f14';
    const BLUE = '#3757e8';
    const NAVY = '#151c6b';

    /* The classic 4×4 ordered-dither threshold map, normalised. A cell is drawn
       when its intensity clears the threshold at its own grid position, so
       neighbouring cells switch on at different intensities and the fade
       becomes a pattern rather than a gradient. */
    const BAYER = [
      [0, 8, 2, 10],
      [12, 4, 14, 6],
      [3, 11, 1, 9],
      [15, 7, 13, 5],
    ].map((row) => row.map((v) => (v + 0.5) / 16));

    const hash = (x: number, y: number) => {
      const h = Math.imul(x * 374761393 + y * 668265263, 1274126177);
      return ((h ^ (h >>> 15)) >>> 0) / 4294967296;
    };

    /** Value noise: hashed lattice, smoothstep between. Cheap, and smooth
        enough that translating it reads as flow rather than as a jump. */
    const noise = (x: number, y: number) => {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      const xf = x - xi;
      const yf = y - yi;
      const u = xf * xf * (3 - 2 * xf);
      const v = yf * yf * (3 - 2 * yf);
      const a = hash(xi, yi);
      const b = hash(xi + 1, yi);
      const c = hash(xi, yi + 1);
      const d = hash(xi + 1, yi + 1);
      const top = a + (b - a) * u;
      const bottom = c + (d - c) * u;
      return top + (bottom - top) * v;
    };

    let dpr = 1;
    let points: { x: number; y: number; born: number }[] = [];
    let frame: number | undefined;
    /** Where the fireball is, and where it is heading. */
    let fx = -999;
    let fy = -999;
    let tx = -999;
    let ty = -999;
    /** Smoothed travel, so the flame leans away from the direction of motion. */
    let vx = 0;
    let vy = 0;
    let seen = false;
    /** Which flame frame is showing, and the cells it resolved to. */
    let beat = -1;
    let cells: [number, number, string][] = [];
    /** The region last painted, so a frame clears what it drew and no more. */
    let box: [number, number, number, number] | null = null;
    /** Whether the wake canvas currently carries anything. */
    let wake = false;
    let ink = '#17160f';
    let accent = '#a53d00';

    const readTokens = () => {
      const cs = getComputedStyle(document.documentElement);
      ink = cs.getPropertyValue('--color-ink').trim() || ink;
      accent = cs.getPropertyValue('--color-accent').trim() || accent;
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      for (const [c, cx] of [[canvas, ctx], [ember, ectx]] as const) {
        c.width = Math.floor(innerWidth * dpr);
        c.height = Math.floor(innerHeight * dpr);
        cx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      box = null;
    };

    /**
     * Resolve one flame frame into cells around the centre.
     *
     * Heat is a radial falloff perturbed by two octaves of noise, and the noise
     * is read at a point that rises with the frame — the flame climbs through a
     * fixed field rather than the field being redrawn under it. Travel shears
     * the sample sideways, so a flame being carried leans back into its wake.
     */
    const flame = (n: number) => {
      const out: [number, number, string][] = [];
      const rise = n * 0.5;
      const lean = Math.max(-1.6, Math.min(1.6, vx * 0.05));
      const drop = Math.max(-1.6, Math.min(1.6, vy * 0.05));

      for (let gx = -SPAN; gx <= SPAN; gx += 1) {
        for (let gy = -SPAN; gy <= SPAN; gy += 1) {
          // Slightly taller than wide, and hotter above centre: heat rises, so
          // a round ball would read as a bead rather than as a flame.
          const r = Math.hypot((gx + lean) * 1.06, (gy + drop) * 0.88 + 0.35);
          let heat = 1 - r / CORE;
          if (gy < 0) heat += -gy * 0.052;
          if (heat < -0.5) continue;

          const nx = gx * 0.62;
          const ny = gy * 0.62 - rise;
          heat += (noise(nx, ny) - 0.5) * 0.42;
          heat += (noise(nx * 2.1 + 40, ny * 2.1 - rise * 0.6) - 0.5) * 0.17;

          // The same threshold that dithers the wake decides the outer edge,
          // which is what dissolves it into loose cells instead of a rim.
          const t = BAYER[((gy % 4) + 4) % 4][((gx % 4) + 4) % 4];
          if (heat < t * 0.2) continue;

          const colour =
            heat > 0.8 ? WHITE
            : heat > 0.58 ? YELLOW
            : heat > 0.4 ? ORANGE
            : heat > 0.26 ? RED
            : heat > 0.12 ? BLUE
            : NAVY;
          out.push([gx, gy, colour]);
        }
      }
      return out;
    };

    const drawFireball = () => {
      if (!ectx) return;
      if (box) ectx.clearRect(box[0], box[1], box[2], box[3]);
      if (!seen) { box = null; return; }

      // Snapped to the grid, or the flame blurs across half-cells and stops
      // looking drawn.
      const ox = Math.round(fx / CELL) * CELL;
      const oy = Math.round(fy / CELL) * CELL;
      for (const [gx, gy, colour] of cells) {
        ectx.fillStyle = colour;
        ectx.fillRect(ox + gx * CELL, oy + gy * CELL, CELL - 1, CELL - 1);
      }
      const reach = (SPAN + 1) * CELL;
      box = [ox - reach, oy - reach, reach * 2, reach * 2];
    };

    const drawWake = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, innerWidth, innerHeight);

      const now = performance.now();
      // Anything older than the wake's life is gone.
      points = points.filter((p) => now - p.born < 620);

      for (const p of points) {
        const age = (now - p.born) / 620;
        // Fades out, and shrinks its reach as it goes, so the wake tapers.
        const strength = (1 - age) ** 1.6;
        const reach = Math.max(1, Math.round(REACH * (1 - age * 0.55)));

        const cx = Math.floor(p.x / CELL);
        const cy = Math.floor(p.y / CELL);

        for (let gx = cx - reach; gx <= cx + reach; gx += 1) {
          for (let gy = cy - reach; gy <= cy + reach; gy += 1) {
            const dx = gx - cx;
            const dy = gy - cy;
            const dist = Math.sqrt(dx * dx + dy * dy) / (reach + 0.6);
            if (dist > 1) continue;

            const intensity = strength * (1 - dist) ** 1.4;
            // The threshold, not a comparison against alpha: this is what makes
            // it dither instead of dissolve.
            const threshold = BAYER[((gy % 4) + 4) % 4][((gx % 4) + 4) % 4];
            if (intensity <= threshold) continue;

            // Cells cool as they fall behind: the hottest are still part of the
            // flame, the oldest are just ink on paper.
            ctx.fillStyle =
              intensity > 0.74 ? ORANGE : intensity > 0.5 ? accent : ink;
            ctx.globalAlpha = Math.min(0.5, 0.16 + intensity * 0.42);
            ctx.fillRect(gx * CELL, gy * CELL, CELL - 1, CELL - 1);
          }
        }
      }
      ctx.globalAlpha = 1;
    };

    const draw = () => {
      frame = requestAnimationFrame(draw);

      // Eased rather than pinned to the pointer: the lag is what makes it read
      // as a thing being carried along rather than a decal on the cursor.
      const nx = fx + (tx - fx) * 0.22;
      const ny = fy + (ty - fy) * 0.22;
      vx += (nx - fx - vx) * 0.3;
      vy += (ny - fy - vy) * 0.3;
      const moved = Math.round(nx / CELL) !== Math.round(fx / CELL)
        || Math.round(ny / CELL) !== Math.round(fy / CELL);
      fx = nx;
      fy = ny;

      // Shape has its own clock; position has every frame. Nothing repaints
      // unless one of them has actually changed.
      const n = Math.floor(performance.now() / FLAME_MS);
      const stepped = n !== beat;
      if (stepped) {
        beat = n;
        if (seen) cells = flame(n);
      }
      if (seen && (stepped || moved)) drawFireball();

      // One frame past empty, so the last wake is cleared rather than left
      // standing on the page.
      if (points.length || wake) {
        wake = points.length > 0;
        drawWake();
      }
    };

    const start = () => {
      if (frame === undefined) frame = requestAnimationFrame(draw);
    };

    const stop = () => {
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = undefined;
    };

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;

      tx = e.clientX;
      ty = e.clientY;
      if (!seen) {
        // Arrive where the pointer already is, rather than flying in from the
        // corner on the first move.
        seen = true;
        fx = tx;
        fy = ty;
        // Resolve a flame on the next frame rather than waiting out the beat.
        beat = -1;
      }

      const last = points[points.length - 1];
      // Sampling by distance rather than by event keeps the wake even: a slow
      // drag would otherwise pile every sample into one spot.
      if (last && Math.hypot(e.clientX - last.x, e.clientY - last.y) < CELL * 0.9) return;

      points.push({ x: e.clientX, y: e.clientY, born: performance.now() });
      if (points.length > TAIL) points.shift();
    });

    /* The wake is a record of movement, so it goes when the pointer does. The
       fireball stays where it was left, still burning: it is meant to be on
       screen always. */
    document.addEventListener('pointerleave', () => {
      points = [];
      ctx?.clearRect(0, 0, innerWidth, innerHeight);
    });

    /* A hidden tab gets nothing. The browser throttles rAF there anyway, but
       stopping outright also means no half-drawn wake waiting on return. */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stop();
        points = [];
        ctx?.clearRect(0, 0, innerWidth, innerHeight);
      } else {
        start();
      }
    });

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    });

    readTokens();
    resize();
    start();
  }
</script>
