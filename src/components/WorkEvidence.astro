---
/**
 * The work, as evidence for the claim above it.
 *
 * Replaces WorkWall on the homepage. The bento was built to be looked at — big
 * tiles, parallax, a wall of imagery. That is the wrong job here: the line above
 * it says "but first, some work", so these have to be read, quickly, and then
 * left behind. A small tile with the client and the outcome under it does that;
 * a wall does not.
 *
 * The outcome line comes straight from each case study's `outcome` field, so it
 * is the same sentence the case study opens with rather than a second one
 * written for the homepage that could drift out of step with it.
 *
 * WorkWall is left in the tree but is now unused — /work builds its list from
 * WorkIndex, not the bento. Swap it back here if the wall is wanted again.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

const items = entries.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  client: entry.data.client,
  sector: entry.data.sector,
  outcome: entry.data.outcome,
  img: entry.data.gallery?.[0],
}));
---

<section class="evidence" aria-label="Selected work">
  <ul class="evidence__grid">
    {
      items.map((item) => (
        <li>
          <a class="ev" href={`/work/${item.slug}/`}>
            <div class="ev__frame">
              {item.img && (
                <Image
                  src={item.img}
                  alt={`${item.title} — ${item.outcome}`}
                  widths={[280, 560]}
                  sizes="(min-width: 1280px) 18vw, (min-width: 768px) 30vw, 45vw"
                  loading="lazy"
                  decoding="async"
                  class="ev__img"
                />
              )}
            </div>

            <h3 class="ev__title font-display">{item.title}</h3>
            <p class="label ev__meta">{item.sector}</p>
            <p class="ev__outcome">{item.outcome}</p>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="evidence__foot">
    <a href="/work" class="evidence__all font-mono">
      All projects <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>

<style>
  .evidence {
    padding: 2.25rem 1.5rem 0;
  }
  @media (min-width: 768px) {
    .evidence { padding: 3rem 5rem 0; }
  }

  .evidence__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 768px) {
    .evidence__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.25rem 1.5rem; }
  }
  /* Five case studies, five columns — the row stays one line rather than
     leaving a single orphan tile under a row of four. */
  @media (min-width: 1180px) {
    .evidence__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  .ev {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ev__frame {
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: 3px;
    background: var(--color-fill);
    aspect-ratio: 4 / 3;
  }

  .ev__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .ev:hover .ev__img,
  .ev:focus-visible .ev__img {
    transform: scale(1.04);
  }
  @media (prefers-reduced-motion: reduce) {
    .ev__img,
    .ev:hover .ev__img { transition: none; transform: none; }
  }

  .ev__title {
    margin: 0.875rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .ev__meta {
    margin-top: 0.375rem;
  }

  .ev__outcome {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-soft);
    text-wrap: pretty;
  }

  .evidence__foot {
    display: flex;
    justify-content: flex-end;
    padding-top: 2rem;
  }
  @media (min-width: 768px) {
    .evidence__foot { padding-top: 2.5rem; }
  }

  .evidence__all {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    transition: border-color 200ms ease;
  }
  .evidence__all:hover,
  .evidence__all:focus-visible {
    border-color: var(--color-ink);
  }
</style>
