---
/** Shared top-of-page block. Keeps /studio, /services and /contact opening
 *  the same way so they read as one site rather than three. */
import EmberFlame from './EmberFlame.astro';

interface Props {
  label: string;
  title: string;
  lede?: string;
  /** Stand a flame in the empty right half of the hero. Opt-in: the block is
   *  shared, and a page that already burns somewhere else does not want two. */
  flame?: boolean;
}
const { label, title, lede, flame = false } = Astro.props;
---

<section class="hero rule-t gutter pt-12 pb-10 md:pt-20 md:pb-16">
  <p class="label mb-8 md:mb-12">{label}</p>
  <h1 class="font-display max-w-[16ch] text-[44px] leading-[1.02] tracking-[-0.024em] text-pretty md:text-[78px] md:tracking-[-0.028em]">
    {title}
  </h1>
  {
    lede && (
      <p class="mt-8 max-w-[46ch] text-lg leading-relaxed text-soft text-pretty md:mt-12 md:text-[22px]">
        {lede}
      </p>
    )
  }

  {
    flame && (
      /* Inside a wrapper spanning the section's padding box and inheriting its
         resolved gutter, so the flame's right edge lands on the content column
         at any width — the same arrangement as the homepage's CTA flame, and
         for the same reason: the gutter is computed from 100%, and an absolute
         child has no equivalent that also excludes the scrollbar. */
      <div class="hero__flame">
        <EmberFlame cols={20} rows={30} />
      </div>
    )
  }
</section>

<style>
  .hero {
    position: relative;
  }

  /* Standing on the rule the next section opens with, out at the content edge.

     Held back below 1024px: the flame is taller than the hero's empty right
     half is wide, and on a narrow column the headline and lede run the full
     measure, so there is nothing over there to stand in. */
  .hero__flame {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero__flame {
      display: flex;
      justify-content: flex-end;
      position: absolute;
      inset-inline: 0;
      padding-inline: inherit;
      bottom: 0;
      pointer-events: none;
    }
  }
</style>
