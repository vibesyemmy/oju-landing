---
/**
 * Every project, in one gallery.
 *
 * /work used to run two sections: a table of case studies, then a card grid
 * headed "Also from the studio" — which told a visitor the second batch was
 * lesser before they had looked at it. Nobody arrives caring about the
 * studio's internal taxonomy.
 *
 * The table was what made merging hard: it had Year and Sector columns, and the
 * brand work carries neither. A gallery has no columns, so those gaps stop
 * existing rather than needing filling or hiding.
 *
 * What the split *was* protecting is real: five projects open a case study and
 * the rest do not, and a uniform grid hides that until someone clicks and gets
 * nothing. The cursor solves it. It carries what happens on click, so the
 * difference is legible before the click rather than after — tiles that lead
 * somewhere say so, tiles that do not just carry their name.
 */
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { SELECTED_WORK, CAMPAIGNS } from '../data/site';
import Lightbox from './Lightbox.astro';

const entries = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/work-selected/*.{webp,png,jpg,jpeg}',
  { eager: true },
);
const campaignFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);
const pick = (
  glob: Record<string, { default: ImageMetadata }>,
  name?: string,
) => {
  if (!name) return undefined;
  const hit = Object.keys(glob).find((k) => k.endsWith(`/${name}`));
  return hit ? glob[hit].default : undefined;
};

type Tile = {
  title: string;
  meta: string;
  img?: ImageMetadata;
  href?: string;
  /** Opens the viewer on this project's set, for work without a case study. */
  setIndex?: number;
  /** What the cursor promises. */
  action?: string;
  external?: boolean;
};

const caseStudies: Tile[] = entries.map((e) => ({
  title: e.data.title,
  meta: `${e.data.client} · ${e.data.sector}`,
  img: e.data.gallery?.[0],
  href: `/work/${e.id}/`,
  action: 'Read the case study',
}));

/**
 * Everything the studio has for a company, gathered into one set: the project
 * image, then any campaign pieces run for the same client. A project without a
 * case study is no longer a dead tile — it opens what there is.
 */
const sets = SELECTED_WORK.map((p) => {
  const own = pick(files, p.image);
  const campaigns = CAMPAIGNS.filter((c) => c.client === p.name).map((c) => ({
    img: pick(campaignFiles, c.image),
    caption: c.caption,
  }));
  return {
    title: p.name,
    line: p.line,
    prototype: p.prototype,
    shots: [
      ...(own ? [{ img: own, caption: p.services.join(' · ') }] : []),
      ...campaigns.filter((c) => c.img),
    ] as { img: ImageMetadata; caption: string }[],
  };
});

const projects: Tile[] = sets.map((set, i) => ({
  title: set.title,
  meta: SELECTED_WORK[i].services.join(' · '),
  img: set.shots[0]?.img,
  setIndex: i,
  action: set.shots.length > 1 ? `View ${set.shots.length} pieces` : 'View the work',
}));

const tiles = [...caseStudies, ...projects].filter((t) => t.img);

/* Flattened, because the viewer holds every slide and shows one set at a time.
   Resolved at build time and parked in data attributes: an image inside a
   closed dialog is fetched like any other, so a src here would pull all of
   them on every visit. */
const slides = sets.flatMap((set, si) =>
  set.shots.map((shot) => ({ ...shot, set: si, title: set.title })),
);
const shotUrls = await Promise.all(
  slides.map((s) => getImage({ src: s.img, widths: [600, 900, 1400], format: 'webp' })),
);

const lbSlides = slides.map((s, i) => ({
  src: shotUrls[i].src,
  srcSet: shotUrls[i].srcSet.attribute,
  alt: `${s.title} — ${s.caption}`,
  width: s.img.width,
  height: s.img.height,
  caption: s.caption,
  data: { set: String(s.set) },
}));
---

<section class="gallery-wrap rule-t gutter py-14 md:py-22" aria-labelledby="work-heading">
  <h1
    id="work-heading"
    class="font-display mb-9 text-[44px] leading-tight tracking-tight md:mb-14 md:text-[78px]"
  >
    Selected work
  </h1>

  <ul class="gallery" data-gallery>
    {
      tiles.map((t, i) => {
        const inner = (
          <>
            <div class="tile__frame">
              <Image
                src={t.img!}
                alt=""
                widths={[400, 800, 1200]}
                sizes="(min-width: 1024px) 46vw, 92vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
                class="tile__img"
              />
              <span class="tile__num font-mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="tile__caption">
                <span class="tile__name font-display">{t.title}</span>
                <span class="tile__meta font-mono">{t.meta}</span>
              </span>
            </div>
          </>
        );

        return (
          <li
            class="tile"
            data-label={t.title}
            data-action={t.action ?? ''}
          >
            {t.href ? (
              <a
                class="tile__link"
                href={t.href}
                aria-label={`${t.title} — ${t.action}`}
              >
                {inner}
              </a>
            ) : (
              <button
                type="button"
                class="tile__link"
                data-open-set={t.setIndex}
                aria-label={`${t.title} — ${t.action}`}
              >
                {inner}
              </button>
            )}
          </li>
        );
      })
    }
  </ul>

  {/* Follows the pointer and says what a click will do. Built here rather than
      per-tile so one element trails the cursor across the whole gallery. */}
  <div class="magnet" data-magnet aria-hidden="true">
    <span class="magnet__label" data-magnet-label></span>
  </div>

  {/* Everything the studio has for one company. */}
  <Lightbox label="Project viewer" slides={lbSlides} sizes="(min-width: 1024px) 62vw, 92vw">
    <Fragment slot="bar">
      <span data-pv-title></span><span class="pv__count" data-pv-count></span>
    </Fragment>
    <Fragment slot="meta">
      <p class="pv__caption" data-pv-caption></p>
      <p class="pv__line" data-pv-line></p>
      <a class="pv__proto" data-pv-proto href="#" target="_blank" rel="noopener noreferrer" hidden>
        View the prototype <span aria-hidden="true">&#8599;</span>
      </a>
    </Fragment>
  </Lightbox>
</section>

<script is:inline define:vars={{ setMeta: sets.map((s) => ({ title: s.title, line: s.line, prototype: s.prototype ?? null, count: s.shots.length })) }}>
  window.__ojuSets = setMeta;
</script>

<style>
  .gallery-wrap {
    position: relative;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 640px) {
    .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  }
  @media (min-width: 1180px) {
    .gallery { gap: 2rem; }
  }

  .tile {
    position: relative;
  }

  /* Buttons and anchors both, so they need levelling. */
  .tile__link {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
  }

  .tile__frame {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background: var(--color-fill);
    aspect-ratio: 4 / 3;
  }

  .tile__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 900ms cubic-bezier(0.16, 0.84, 0.28, 1);
  }
  /* The zoom happens inside a fixed frame, so the tile never moves and the
     grid never reflows — only what you see through it changes. */
  .tile:hover .tile__img,
  .tile:focus-within .tile__img {
    transform: scale(1.07);
  }

  .tile__num {
    position: absolute;
    top: 0.875rem;
    right: 1rem;
    z-index: 2;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: rgb(242 239 233 / 0.75);
    mix-blend-mode: difference;
  }

  /* The name sits on the artwork, so it needs its own ground: these images run
     from a near-white Harcourt board to a bright yellow Poseidon grid, and pale
     type alone would vanish on half of them. The scrim is the darkest at the
     very bottom and gone by the middle, so it reads as a weighted edge rather
     than a bar across the picture. */
  .tile__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 3.5rem 1.125rem 1.125rem;
    color: var(--color-paper);
    /* Weighted for the lightest tile in the set, not the average one. Over the
       near-white Insidify board the name lands around 3.2:1 with a gentler
       scrim — fine for text this size, but thin for something no automated
       check can catch, since contrast over an image is not measurable. */
    background: linear-gradient(
      to top,
      rgb(19 18 12 / 0.9) 0%,
      rgb(19 18 12 / 0.72) 34%,
      rgb(19 18 12 / 0) 100%
    );
    pointer-events: none;
  }
  @media (min-width: 768px) {
    .tile__caption { padding: 4.5rem 1.5rem 1.375rem; }
  }

  .tile__name {
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .tile__name { font-size: 1.625rem; }
  }

  .tile__meta {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(242 239 233 / 0.82);
  }

  .tile__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 4px;
  }


  /* Page-specific viewer copy. The shell owns everything structural. */
  :global(.pv__count) { color: rgb(242 239 233 / 0.55); }
  :global(.lb.is-single .pv__count) { display: none; }

  :global(.pv__caption) { font-size: 0.9375rem; line-height: 1.5; }
  @media (min-width: 768px) {
    :global(.pv__caption) { font-size: 1.0625rem; }
  }
  :global(.pv__line) {
    margin: 0.5rem auto 0;
    max-width: 56ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(242 239 233 / 0.55);
  }
  :global(.pv__proto) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.875rem;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-paper);
    text-decoration: none;
    border-bottom: 1px solid rgb(242 239 233 / 0.4);
  }
  :global(.pv__proto:hover) { border-color: var(--color-paper); }
  :global(.pv__proto[hidden]) { display: none; }

  /* ── the cursor ─────────────────────────────────────────────────── */
  .magnet {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: grid;
    place-items: center;
    min-width: 104px;
    min-height: 104px;
    padding: 0 1.25rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-paper);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-50%, -50%, 0) scale(0.6);
    transition: opacity 260ms ease, transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .magnet.is-on {
    opacity: 1;
    transform: translate3d(-50%, -50%, 0) scale(1);
  }
  /* Nothing to promise: the disc shrinks to a dot rather than showing an empty
     pill, so a tile that leads nowhere still reads as deliberate. */
  .magnet.is-bare {
    min-width: 18px;
    min-height: 18px;
    padding: 0;
  }

  .magnet__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    text-align: center;
  }

  /* A cursor follower is meaningless without a cursor, and the tiles carry
     their own names anyway. */
  @media (hover: none) {
    .magnet { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile__img,
    .tile:hover .tile__img,
    .magnet {
      transition: none;
      transform: translate3d(-50%, -50%, 0);
    }
    .tile:hover .tile__img { transform: none; }
  }
</style>

<script>
  /**
   * The project viewer.
   *
   * A company without a case study still has work: its project image, plus any
   * campaign pieces run for the same client. Opening a tile shows that set, and
   * the set is the scope — the shared viewer walks whatever indices it is given.
   */
  import { createLightbox } from '../lib/lightbox';

  const root = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const meta = (window as any).__ojuSets as
    | { title: string; line: string; prototype: string | null; count: number }[]
    | undefined;

  if (root && meta) {
    const titleEl = root.querySelector<HTMLElement>('[data-pv-title]');
    const countEl = root.querySelector<HTMLElement>('[data-pv-count]');
    const captionEl = root.querySelector<HTMLElement>('[data-pv-caption]');
    const lineEl = root.querySelector<HTMLElement>('[data-pv-line]');
    const protoEl = root.querySelector<HTMLAnchorElement>('[data-pv-proto]');

    /** Which project's set is open. The scope follows it. */
    let openSet = 0;

    const lb = createLightbox(root, {
      scope: () =>
        [...root.querySelectorAll<HTMLElement>('[data-lb-slide]')]
          .map((el, i) => ({ el, i }))
          .filter(({ el }) => Number(el.dataset.set) === openSet)
          .map(({ i }) => i),
      onShow: ({ slide, position, total }) => {
        if (countEl) countEl.textContent = total > 1 ? `  ${position} / ${total}` : '';
        if (captionEl) captionEl.textContent = slide.dataset.caption ?? '';
      },
    });

    if (lb) {
      document.querySelectorAll<HTMLButtonElement>('[data-open-set]').forEach((b) =>
        b.addEventListener('click', () => {
          openSet = Number(b.dataset.openSet);
          const info = meta[openSet];
          const first = lb.slides.findIndex((s) => Number(s.dataset.set) === openSet);
          if (first === -1) return;

          root.classList.toggle('is-single', info.count === 1);
          if (titleEl) titleEl.textContent = info.title;
          if (lineEl) lineEl.textContent = info.line ?? '';
          if (protoEl) {
            protoEl.hidden = !info.prototype;
            if (info.prototype) protoEl.href = info.prototype;
          }
          lb.open(first, b);
        }),
      );
    }
  }
</script>

<script>
  /**
   * The cursor follower.
   *
   * It trails the pointer rather than tracking it exactly — the lag is the
   * whole effect — so position is eased toward the target on a frame loop
   * instead of being written on every pointermove.
   *
   * The loop only runs while the pointer is over the gallery. A follower that
   * animates all the time costs a frame budget on every page it appears on for
   * no visible reason.
   */
  const wrap = document.querySelector<HTMLElement>('.gallery-wrap');
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const magnet = document.querySelector<HTMLElement>('[data-magnet]');
  const label = document.querySelector<HTMLElement>('[data-magnet-label]');

  if (wrap && gallery && magnet && label && matchMedia('(hover: hover)').matches) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let frame: number | undefined;
    let inside = false;

    const tick = () => {
      // Ease toward the pointer. Higher is snappier; this trails by enough to
      // read as weight without feeling broken.
      const k = reduced.matches ? 1 : 0.16;
      x += (targetX - x) * k;
      y += (targetY - y) * k;
      magnet.style.left = `${x}px`;
      magnet.style.top = `${y}px`;
      if (inside) frame = requestAnimationFrame(tick);
      else frame = undefined;
    };

    const start = () => {
      if (frame === undefined) frame = requestAnimationFrame(tick);
    };

    gallery.addEventListener('pointermove', (e) => {
      targetX = e.clientX;
      targetY = e.clientY;

      const tile = (e.target as HTMLElement).closest<HTMLElement>('.tile');
      const action = tile?.dataset.action ?? '';
      const name = tile?.dataset.label ?? '';

      if (tile) {
        // The action is the point of the thing: it says whether a click leads
        // anywhere, which the grid alone cannot show.
        label.textContent = action || name;
        magnet.classList.toggle('is-bare', !action);
      }
      magnet.classList.add('is-on');

      if (!inside) {
        inside = true;
        // Jump to the pointer on entry, or it slides in from wherever it was
        // left, which reads as a stray object rather than the cursor.
        x = targetX;
        y = targetY;
      }
      start();
    });

    gallery.addEventListener('pointerleave', () => {
      inside = false;
      magnet.classList.remove('is-on');
    });

    // A tab away with the pointer still over the gallery would otherwise leave
    // the loop running against a pointer that is no longer moving.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        inside = false;
        magnet.classList.remove('is-on');
      }
    });
  }
</script>
