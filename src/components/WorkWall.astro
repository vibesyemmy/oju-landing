---
/**
 * The work wall — the homepage's single work section.
 *
 * Every tile comes from a project's `gallery`, links to that case study, and
 * carries a caption on hover. Nothing decorative: if it is on the wall, there
 * is a case study behind it.
 *
 * The scannable, filterable text index lives on /work. A grid is the better
 * medium for looking; a list is the better medium for finding. Neither repeats
 * the other.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

/* Every tile links now — the unlinked padding variant is gone, so none of
   these are optional any more. */
type Tile = {
  img: ImageMetadata;
  href: string;
  title: string;
  meta: string;
};

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

// Real work first: every gallery image is a way into its case study.
const projectTiles: Tile[] = projects.flatMap((entry) =>
  entry.data.gallery.map((img) => ({
    img,
    href: `/work/${entry.id}/`,
    title: entry.data.title,
    meta: `${entry.data.services.join(', ')} · ${entry.data.year}`,
  })),
);

/* Three columns, not six. Every tile now links to a case study, so the wall is
   as big as the work is — six tiles across six columns would read as a broken
   grid rather than an honest one. Fewer, larger tiles suit real work better. */
const COLUMN_COUNT = 3;
const COLUMNS: Tile[][] = Array.from({ length: COLUMN_COUNT }, (_, c) =>
  projectTiles.filter((_, i) => i % COLUMN_COUNT === c),
);

const count = String(projects.length).padStart(2, '0');
---

<section class="workwall">
  <div class="workwall__head">
    <h2 class="label">Selected work <span class="text-ink">· {count}</span></h2>
    <a href="/work" class="workwall__all font-mono">
      All projects <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <div class="wall">
    {
      COLUMNS.map((col) => (
        <div class="wall__col">
          <div class="wall__track">
            {col.map((tile) => (
              <a href={tile.href} class="tile tile--link">
                <Image
                  src={tile.img}
                  alt={`${tile.title} · Ojú`}
                  widths={[460, 920]}
                  sizes="(max-width: 900px) 50vw, 460px"
                  quality={58}
                  loading="lazy"
                  decoding="async"
                  class="tile__img"
                />
                <span class="tile__cap">
                  <span class="tile__title">{tile.title}</span>
                  <span class="tile__meta font-mono">{tile.meta}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .workwall {
    border-top: 1px solid var(--color-rule);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  .workwall__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 var(--gutter) clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 768px) {
    .workwall__head { padding-left: 5rem; padding-right: 5rem; }
  }

  .workwall__all {
    font-size: 13px;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 4px;
    white-space: nowrap;
  }
  .workwall__all:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }

  .wall {
    display: flex;
    justify-content: center;
    gap: 10px;
    /* Headroom for the upward drift below — without it the tallest-drifting
       column rides up over the section heading. */
    padding: 60px 10px 0;
  }

  .wall__col { flex: 1 1 0; max-width: 460px; min-width: 0; }

  .wall__track {
    display: flex;
    flex-direction: column;
    gap: 10px;
    --d-from: 0px;
    --d-to: 0px;
    transform: translateY(var(--d-from));
  }

  /* Staggered starts so the grid reads as masonry, not aligned stacks. */
  .wall__col:nth-child(2) .wall__track { margin-top: 56px; }
  .wall__col:nth-child(3) .wall__track { margin-top: 22px; }

  /* Below the breakpoint the third column would leave a lone orphan tile, so
     it folds into two and every column keeps a pair. */
  @media (max-width: 900px) {
    .wall__col:nth-child(3) { display: none; }
  }

  .tile {
    position: relative;
    display: block;
    border-radius: 6px;
    border: 1px solid rgb(23 22 15 / 0.09);
    background: #f7f4ee;
    overflow: hidden;
  }

  .tile__img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Caption is the reward for engaging, not permanent chrome. */
  .tile__cap {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 14px 12px;
    background: linear-gradient(to top, rgb(23 22 15 / 0.82), rgb(23 22 15 / 0));
    color: #f6f3ec;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 260ms ease, transform 260ms ease;
  }
  .tile__title { font-size: 15px; letter-spacing: -0.01em; }
  .tile__meta { font-size: 11px; color: #cfc9b8; }

  .tile--link:hover .tile__cap,
  .tile--link:focus-visible .tile__cap { opacity: 1; transform: translateY(0); }
  .tile--link:hover .tile__img { transform: scale(1.03); }

  @supports (animation-timeline: view()) {
    .wall__track {
      animation: wall-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 100%;
      will-change: transform;
    }
    /* Gentler than the six-column version: the tiles are half again as wide,
       so the same travel reads as a much bigger movement. */
    .wall__col:nth-child(1) .wall__track { --d-from: 18px;  --d-to: -46px; }
    .wall__col:nth-child(2) .wall__track { --d-from: -10px; --d-to: -22px; }
    .wall__col:nth-child(3) .wall__track { --d-from: 30px;  --d-to: -58px; }

    @keyframes wall-drift {
      from { transform: translateY(var(--d-from)); }
      to   { transform: translateY(var(--d-to)); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__track { animation: none; transform: none; }
    .tile__img { transition: none; }
  }
</style>
