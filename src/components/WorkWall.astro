---
/**
 * The work wall — the homepage's single work section.
 *
 * Tiles come from each project's `gallery`, several per project, so a handful
 * of projects fills a wall. Tiles that belong to a project are links and carry
 * a caption on hover; the rest are unlinked placeholders, decorative only.
 *
 * The scannable, filterable text index lives on /work. A grid is the better
 * medium for looking; a list is the better medium for finding. Neither repeats
 * the other.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

type Tile = {
  img: ImageMetadata;
  href?: string;
  title?: string;
  meta?: string;
};

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

// Real work first: every gallery image is a way into its case study.
const projectTiles: Tile[] = projects.flatMap((entry) =>
  entry.data.gallery.map((img) => ({
    img,
    href: `/work/${entry.id}/`,
    title: entry.data.title,
    meta: `${entry.data.services.join(', ')} · ${entry.data.year}`,
  })),
);

/**
 * PLACEHOLDER PADDING — the author's own portfolio images, used only to keep
 * the wall full while Ojú has few projects. They link nowhere and are hidden
 * from assistive tech. As real galleries land they push these out; delete the
 * files from src/assets/wall/ once nothing needs padding.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/wall/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const used = new Set(projectTiles.map((t) => t.img.src));
const padding: Tile[] = Object.keys(files)
  .sort()
  .map((k) => files[k].default)
  .filter((img) => !used.has(img.src))
  .map((img) => ({ img }));

const MIN_TILES = 24;
const tiles: Tile[] = [
  ...projectTiles,
  ...padding.slice(0, Math.max(0, MIN_TILES - projectTiles.length)),
];

const COLUMN_COUNT = 6;
const COLUMNS: Tile[][] = Array.from({ length: COLUMN_COUNT }, (_, c) =>
  tiles.filter((_, i) => i % COLUMN_COUNT === c),
);

const count = String(projects.length).padStart(2, '0');
---

<section class="workwall">
  <div class="workwall__head">
    <h2 class="label">Selected work <span class="text-ink">&mdash; {count}</span></h2>
    <a href="/work" class="workwall__all font-mono">
      All projects <span aria-hidden="true">&rarr;</span>
    </a>
  </div>

  <div class="wall">
    {
      COLUMNS.map((col) => (
        <div class="wall__col">
          <div class="wall__track">
            {col.map((tile) =>
              tile.href ? (
                <a href={tile.href} class="tile tile--link">
                  <Image
                    src={tile.img}
                    alt={`${tile.title} — Ojú`}
                    widths={[342, 684]}
                    sizes="(max-width: 900px) 50vw, 342px"
                    quality={58}
                    loading="lazy"
                    decoding="async"
                    class="tile__img"
                  />
                  <span class="tile__cap">
                    <span class="tile__title">{tile.title}</span>
                    <span class="tile__meta font-mono">{tile.meta}</span>
                  </span>
                </a>
              ) : (
                <div class="tile" aria-hidden="true">
                  <Image
                    src={tile.img}
                    alt=""
                    widths={[342, 684]}
                    sizes="(max-width: 900px) 50vw, 342px"
                    quality={58}
                    loading="lazy"
                    decoding="async"
                    class="tile__img"
                  />
                </div>
              ),
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .workwall {
    border-top: 1px solid var(--color-rule);
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  .workwall__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 1.5rem clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 768px) {
    .workwall__head { padding-left: 5rem; padding-right: 5rem; }
  }

  .workwall__all {
    font-size: 13px;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--color-ink);
    padding-bottom: 4px;
    white-space: nowrap;
  }
  .workwall__all:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }

  .wall {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 0 10px;
  }

  .wall__col { flex: 1 1 0; max-width: 342px; min-width: 0; }

  .wall__track {
    display: flex;
    flex-direction: column;
    gap: 10px;
    --d-from: 0px;
    --d-to: 0px;
    transform: translateY(var(--d-from));
  }

  /* Staggered starts so the grid reads as masonry, not aligned stacks. */
  .wall__col:nth-child(2) .wall__track { margin-top: 46px; }
  .wall__col:nth-child(3) .wall__track { margin-top: 14px; }
  .wall__col:nth-child(4) .wall__track { margin-top: 62px; }
  .wall__col:nth-child(5) .wall__track { margin-top: 26px; }
  .wall__col:nth-child(6) .wall__track { margin-top: 54px; }

  /* Columns shown by viewport width, at roughly 342px each. */
  .wall__col:nth-child(n + 5) { display: none; }
  @media (min-width: 1700px) {
    .wall__col:nth-child(n + 5) { display: block; }
  }
  @media (max-width: 900px) {
    .wall__col:nth-child(n + 3) { display: none !important; }
  }

  .tile {
    position: relative;
    display: block;
    border-radius: 6px;
    border: 1px solid rgb(23 22 15 / 0.09);
    background: #f7f4ee;
    overflow: hidden;
  }

  .tile__img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Caption is the reward for engaging, not permanent chrome. */
  .tile__cap {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 14px 12px;
    background: linear-gradient(to top, rgb(23 22 15 / 0.82), rgb(23 22 15 / 0));
    color: #f6f3ec;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 260ms ease, transform 260ms ease;
  }
  .tile__title { font-size: 15px; letter-spacing: -0.01em; }
  .tile__meta { font-size: 11px; color: #cfc9b8; }

  .tile--link:hover .tile__cap,
  .tile--link:focus-visible .tile__cap { opacity: 1; transform: translateY(0); }
  .tile--link:hover .tile__img { transform: scale(1.03); }

  @supports (animation-timeline: view()) {
    .wall__track {
      animation: wall-drift linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 100%;
      will-change: transform;
    }
    .wall__col:nth-child(1) .wall__track { --d-from: 24px;  --d-to: -104px; }
    .wall__col:nth-child(2) .wall__track { --d-from: -18px; --d-to: -32px; }
    .wall__col:nth-child(3) .wall__track { --d-from: 44px;  --d-to: -136px; }
    .wall__col:nth-child(4) .wall__track { --d-from: -6px;  --d-to: -58px; }
    .wall__col:nth-child(5) .wall__track { --d-from: 32px;  --d-to: -118px; }
    .wall__col:nth-child(6) .wall__track { --d-from: -12px; --d-to: -44px; }

    @keyframes wall-drift {
      from { transform: translateY(var(--d-from)); }
      to   { transform: translateY(var(--d-to)); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__track { animation: none; transform: none; }
    .tile__img { transition: none; }
  }
</style>
