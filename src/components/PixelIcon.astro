---
/**
 * A small animated pixel icon for the method stages.
 *
 * Nine cells at the 9px pitch the fires use, so an icon pixel and a fire cell
 * are the same square. That fixes the icon at 81px, and the arithmetic is the
 * whole design: a legible glass needs a seven-cell circle plus two for the
 * handle, so nine cells is the floor, and at a 9px pitch nine cells is 81px.
 * Smaller means either thinner pixels or a glyph too coarse to read as a
 * glass.
 *
 * Colours are the fireball's, imported from src/lib/fire.ts: a cool rim and a
 * hot centre, the same structure the fire itself has. The glass is blue with a
 * navy handle, and what the scan turns up runs orange to yellow.
 *
 * The rim is drawn with the midpoint circle algorithm rather than by
 * thresholding a distance field. The latter is the obvious way to do it and it
 * looks wrong: at a ten-cell diameter it leaves the outline lumpy and doubled
 * in places, because rounding a smooth function is not the same problem as
 * drawing a circle. Midpoint gives the canonical pixel circle, symmetric in
 * all eight octants.
 *
 * Discovery: a glass with a line scanning down through it, and a cell that
 * catches when the scan passes over it — looking, then finding. The scan runs
 * at 8fps, slow enough to read as deliberate rather than as a flicker.
 *
 * Under prefers-reduced-motion it draws one still frame with the scan parked
 * and nothing found. It stops when scrolled out of view.
 */
interface Props {
  /** Which glyph to draw. Only 'discovery' is drawn so far. */
  name: 'discovery';
  /** Accessible name, or omit to leave it decorative. */
  label?: string;
  class?: string;
}

const { name, label, class: className = '' } = Astro.props;
---

<canvas
  class:list={['picon', className]}
  data-picon={name}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}></canvas>

<style>
  .picon {
    display: block;
  }
</style>

<script>
  import { BLUE, NAVY, ORANGE, YELLOW } from '../lib/fire';

  /** Cells across, and css px per cell. 9 × 9 = an 81px icon. */
  const GRID = 9;
  const PIXEL = 9;
  /** One animation frame. 8fps: deliberate, not a flicker. */
  const BEAT_MS = 125;

  type Cell = [number, number, string];

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-picon]')) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) continue;

    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const size = GRID * PIXEL;
    canvas.style.width = `${size}px`;
    canvas.style.height = `${size}px`;
    canvas.width = Math.floor(size * dpr);
    canvas.height = Math.floor(size * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    /* ── the glass ───────────────────────────────────────────────────
       A ring from a radius and a handle from a line, so the circle is round
       at any size and the two always meet. */
    // Integer centre and radius: the midpoint algorithm wants both, and an
    // off-grid centre is what makes a small pixel circle look lopsided.
    const CX = 3;
    const CY = 3;
    const R = 3;

    const rim = new Set<string>();
    {
      let x = R;
      let y = 0;
      let err = 0;
      while (x >= y) {
        for (const [dx, dy] of [
          [x, y], [y, x], [-y, x], [-x, y],
          [-x, -y], [-y, -x], [y, -x], [x, -y],
        ]) {
          rim.add(`${CX + dx},${CY + dy}`);
        }
        y += 1;
        if (err <= 0) err += 2 * y + 1;
        else { x -= 1; err -= 2 * x + 1; }
      }
    }

    const ring: Cell[] = [];
    const lens: [number, number][] = [];
    for (let x = 0; x < GRID; x += 1) {
      for (let y = 0; y < GRID; y += 1) {
        if (rim.has(`${x},${y}`)) ring.push([x, y, BLUE]);
        else if (Math.hypot(x - CX, y - CY) < R - 0.5) lens.push([x, y]);
      }
    }
    /* Handle: straight down the diagonal from the rim to the corner. It starts
       clear of the rim rather than on it — the handle is painted after the
       ring, so an overlapping first cell silently ate the rim's bottom-right
       corner and left the circle with a bite out of it. Diagonally adjacent is
       enough to read as joined. */
    const handle: Cell[] = [];
    for (let t = CX + R; t < GRID; t += 1) handle.push([t, t, NAVY]);

    /** The cell the scan turns up. Below and right of centre, so the scan has
        somewhere to travel before it gets there. */
    const find: [number, number] = [Math.round(CX) + 1, Math.round(CY) + 2];

    const top = Math.ceil(CY - R);
    const span = Math.round(2 * R);
    /** Sweep, then a short rest before starting over. A long rest leaves the
        icon sitting as a bare outline for most of its cycle. */
    const CYCLE = span + 5;

    const paint = (beat: number) => {
      ctx.clearRect(0, 0, size, size);

      // The scan line's row, sweeping the lens top to bottom then resting.
      const phase = beat % CYCLE;
      const row = top + Math.min(phase, span);
      const sweeping = phase <= span;
      const found = !sweeping || row >= find[1];

      for (const [x, y] of lens) {
        if (sweeping && y === row) {
          ctx.fillStyle = ORANGE;
          ctx.fillRect(x * PIXEL, y * PIXEL, PIXEL - 1, PIXEL - 1);
        }
      }

      // What the scan turned up stays lit once passed, and rests lit between
      // sweeps — the icon is never a bare outline for long.
      if (found) {
        ctx.fillStyle = YELLOW;
        ctx.fillRect(find[0] * PIXEL, find[1] * PIXEL, PIXEL - 1, PIXEL - 1);
      }

      for (const [x, y, colour] of [...ring, ...handle]) {
        ctx.fillStyle = colour;
        ctx.fillRect(x * PIXEL, y * PIXEL, PIXEL - 1, PIXEL - 1);
      }
    };

    let beat = 0;
    let frame: number | undefined;
    let last = 0;

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      if (now - last < BEAT_MS) return;
      last = now;
      beat += 1;
      paint(beat);
    };

    const start = () => {
      if (frame === undefined && !reduced.matches) frame = requestAnimationFrame(draw);
    };
    const stop = () => {
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = undefined;
    };

    // A still frame first, so the icon is drawn whether or not it animates.
    paint(reduced.matches ? CYCLE - 1 : 0);

    new IntersectionObserver((entries) => {
      for (const e of entries) (e.isIntersecting ? start() : stop());
    }).observe(canvas);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
