---
/**
 * The animated pixel icons for the method stages.
 *
 * Eight cells at the 9px pitch the fires use, so an icon pixel and a fire cell
 * are the same square. With the pitch fixed, cell count is the only size
 * control there is, and eight is the floor: a legible circle needs seven cells
 * and the glass's handle needs somewhere to go.
 *
 * That square is the whole brief for the drawings. Nothing with fine detail
 * survives at this size, so each stage is a silhouette that reads at a glance
 * and animates by having cells appear rather than by moving anything — cells
 * only exist on the grid, so nothing can travel between them.
 *
 *   discovery — a glass, with a line scanning down it and a cell that catches
 *   design    — a board filling in, one cell placed at a time
 *   build     — blocks stacking on a ground line, bottom up
 *   support   — a flame that keeps burning
 *
 * Colours are the fireball's, imported from src/lib/fire.ts so there is one
 * source for them: blue and navy for the object, orange and yellow for what
 * the stage is doing to it. In each icon the newest cell is the hottest, which
 * is what carries the eye to the thing that just changed.
 *
 * The glass's rim uses the midpoint circle algorithm rather than a thresholded
 * distance field. The latter is the obvious way and it looks wrong: at this
 * diameter it leaves the outline lumpy and doubled, because rounding a smooth
 * function is not the same problem as drawing a circle.
 *
 * The flame is hand-plotted instead. Generating shapes keeps circles and lines
 * honest, but a flame has no formula worth the trouble at eight cells, and
 * three drawn frames flicker better than noise does at this scale.
 *
 * Under prefers-reduced-motion each draws one still frame of its finished
 * state, not an empty board or a bare rim. They stop when scrolled out of view.
 */
export type IconName = 'discovery' | 'design' | 'build' | 'support';

interface Props {
  name: IconName;
  /** Accessible name, or omit to leave it decorative. */
  label?: string;
  class?: string;
}

const { name, label, class: className = '' } = Astro.props;
---

<canvas
  class:list={['picon', className]}
  data-picon={name}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}></canvas>

<style>
  .picon {
    display: block;
  }
</style>

<script>
  import { BLUE, NAVY, ORANGE, YELLOW } from '../lib/fire';

  /** Cells across, and css px per cell. 8 × 9 = a 72px icon. */
  const GRID = 8;
  const PIXEL = 9;
  /** One animation frame. 8fps: deliberate, not a flicker. */
  const BEAT_MS = 125;

  type Cell = [number, number, string];
  /** A glyph is its cells at a given beat, and how long before it repeats. */
  type Glyph = { cells: (beat: number) => Cell[]; cycle: number };

  const CHARS: Record<string, string> = { B: BLUE, N: NAVY, O: ORANGE, Y: YELLOW };

  /** Rows of characters to cells, so a hand-drawn glyph reads as itself here. */
  const art = (rows: string[]): Cell[] => {
    const out: Cell[] = [];
    rows.forEach((row, y) => {
      [...row].forEach((ch, x) => {
        if (CHARS[ch]) out.push([x, y, CHARS[ch]]);
      });
    });
    return out;
  };

  /* ── discovery ───────────────────────────────────────────────────── */
  const discovery = (): Glyph => {
    const CX = 3;
    const CY = 3;
    const R = 3;

    const rim = new Set<string>();
    let x = R;
    let y = 0;
    let err = 0;
    while (x >= y) {
      for (const [dx, dy] of [
        [x, y], [y, x], [-y, x], [-x, y],
        [-x, -y], [-y, -x], [y, -x], [x, -y],
      ]) {
        rim.add(`${CX + dx},${CY + dy}`);
      }
      y += 1;
      if (err <= 0) err += 2 * y + 1;
      else { x -= 1; err -= 2 * x + 1; }
    }

    const ring: Cell[] = [];
    const lens: [number, number][] = [];
    for (let cx = 0; cx < GRID; cx += 1) {
      for (let cy = 0; cy < GRID; cy += 1) {
        if (rim.has(`${cx},${cy}`)) ring.push([cx, cy, BLUE]);
        else if (Math.hypot(cx - CX, cy - CY) < R - 0.5) lens.push([cx, cy]);
      }
    }

    /* Handle: down the diagonal from the rim to the corner, starting clear of
       it. The handle is painted after the ring, so an overlapping first cell
       silently ate the rim's corner and left a bite out of the circle. */
    const handle: Cell[] = [];
    for (let t = CX + R; t < GRID; t += 1) handle.push([t, t, NAVY]);

    /** What the scan turns up: below and right of centre, so the sweep has
        somewhere to travel before it gets there. */
    const find: [number, number] = [CX + 1, CY + 2];
    const top = CY - R;
    const span = 2 * R;
    // Sweep plus a short rest. A long rest leaves the icon a bare outline for
    // most of its cycle.
    const cycle = span + 5;

    return {
      cycle,
      cells: (beat) => {
        const phase = beat % cycle;
        const row = top + Math.min(phase, span);
        const sweeping = phase <= span;
        const out: Cell[] = [];

        if (sweeping) {
          for (const [lx, ly] of lens) if (ly === row) out.push([lx, ly, ORANGE]);
        }
        // Stays lit once passed, and through the rest, so the glass is never
        // just an empty outline.
        if (!sweeping || row >= find[1]) out.push([find[0], find[1], YELLOW]);
        return [...out, ...ring, ...handle];
      },
    };
  };

  /* ── design ──────────────────────────────────────────────────────── */
  const design = (): Glyph => {
    const frame: Cell[] = [];
    for (let x = 1; x <= 6; x += 1) frame.push([x, 1, BLUE], [x, 6, BLUE]);
    for (let y = 2; y <= 5; y += 1) frame.push([1, y, BLUE], [6, y, BLUE]);

    const slots: [number, number][] = [];
    for (let y = 2; y <= 5; y += 1) {
      for (let x = 2; x <= 5; x += 1) slots.push([x, y]);
    }

    const cycle = slots.length + 6;
    return {
      cycle,
      cells: (beat) => {
        const phase = beat % cycle;
        const placed = Math.min(phase, slots.length);
        const out: Cell[] = [];
        for (let i = 0; i < placed; i += 1) {
          const [x, y] = slots[i];
          // The one just placed is hot; everything before it has cooled.
          const hot = i === placed - 1 && phase <= slots.length;
          out.push([x, y, hot ? YELLOW : ORANGE]);
        }
        return [...out, ...frame];
      },
    };
  };

  /* ── build ───────────────────────────────────────────────────────── */
  const build = (): Glyph => {
    const ground: Cell[] = [];
    for (let x = 0; x < GRID; x += 1) ground.push([x, 7, NAVY]);

    // Uneven, so it reads as something being built rather than as a chart.
    const heights = [2, 4, 3, 5, 2, 4];
    const order: [number, number][] = [];
    heights.forEach((h, i) => {
      for (let k = 0; k < h; k += 1) order.push([i + 1, 6 - k]);
    });

    const cycle = order.length + 6;
    return {
      cycle,
      cells: (beat) => {
        const phase = beat % cycle;
        const laid = Math.min(phase, order.length);
        const out: Cell[] = [];
        for (let i = 0; i < laid; i += 1) {
          const [x, y] = order[i];
          const hot = i === laid - 1 && phase <= order.length;
          out.push([x, y, hot ? YELLOW : BLUE]);
        }
        return [...out, ...ground];
      },
    };
  };

  /* ── support ─────────────────────────────────────────────────────── */
  const support = (): Glyph => {
    const frames = [
      art([
        '........',
        '...Y....',
        '..OYO...',
        '..OYO...',
        '.BOYOB..',
        '.BOOOB..',
        '..BBB...',
        '........',
      ]),
      art([
        '........',
        '..Y.....',
        '..YO....',
        '.OOYO...',
        '.BOYOB..',
        '.BOOOB..',
        '..BBB...',
        '........',
      ]),
      art([
        '........',
        '....Y...',
        '...OY...',
        '..OYOO..',
        '.BOYOB..',
        '.BOOOB..',
        '..BBB...',
        '........',
      ]),
    ];
    // Two beats a frame: at one, the flicker is too quick to read as a flame.
    return {
      cycle: frames.length * 2,
      cells: (beat) => frames[Math.floor(beat / 2) % frames.length],
    };
  };

  const GLYPHS: Record<string, () => Glyph> = { discovery, design, build, support };

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-picon]')) {
    const ctx = canvas.getContext('2d', { alpha: true });
    const make = GLYPHS[canvas.dataset.picon ?? ''];
    if (!ctx || !make) continue;

    const glyph = make();
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const size = GRID * PIXEL;
    canvas.style.width = `${size}px`;
    canvas.style.height = `${size}px`;
    canvas.width = Math.floor(size * dpr);
    canvas.height = Math.floor(size * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const paint = (beat: number) => {
      ctx.clearRect(0, 0, size, size);
      for (const [x, y, colour] of glyph.cells(beat)) {
        ctx.fillStyle = colour;
        ctx.fillRect(x * PIXEL, y * PIXEL, PIXEL - 1, PIXEL - 1);
      }
    };

    let beat = 0;
    let frame: number | undefined;
    let last = 0;

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      if (now - last < BEAT_MS) return;
      last = now;
      beat += 1;
      paint(beat);
    };

    const start = () => {
      if (frame === undefined && !reduced.matches) frame = requestAnimationFrame(draw);
    };
    const stop = () => {
      if (frame !== undefined) cancelAnimationFrame(frame);
      frame = undefined;
    };

    // The finished state when still, rather than an empty board or a bare rim.
    paint(reduced.matches ? glyph.cycle - 1 : 0);

    new IntersectionObserver((entries) => {
      for (const e of entries) (e.isIntersecting ? start() : stop());
    }).observe(canvas);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
