---
import { NAV, SITE } from '../data/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<header class="site-header flex h-22 items-center justify-between gutter" data-header>
  <a href="/" class="font-display text-2xl tracking-tight md:text-[27px]" aria-label={`${SITE.name} · home`}>
    {SITE.name}
  </a>

  <nav class="hidden gap-9 md:flex" aria-label="Primary">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={['label transition-colors hover:text-ink', current === item.href && 'text-ink']}
          aria-current={current === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <p class="label hidden md:block">
    {SITE.city} <time id="local-time" class="text-ink" datetime="">--:--</time> WAT
  </p>

  <button
    type="button"
    id="menu-toggle"
    class="flex size-11 flex-col items-end justify-center gap-[5px] md:hidden"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="mobile-nav"
  >
    <span class="h-px w-6 bg-ink"></span>
    <span class="h-px w-6 bg-ink"></span>
  </button>
</header>

<!-- Fixed, not in flow: an open menu covers the page rather than shoving it down. -->
<nav
  id="mobile-nav"
  class="fixed inset-x-0 top-22 z-40 max-h-[calc(100dvh-5.5rem)] overflow-y-auto border-y border-rule bg-paper px-6 py-6 md:hidden"
  aria-label="Primary"
>
  <ul class="flex flex-col gap-1">
    {
      NAV.map((item) => (
        <li>
          <a href={item.href} class="flex min-h-11 items-center text-lg">
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Sticky, because the homepage is nearly seven screens tall and the nav was
     unreachable for all but the first one. */
  .site-header {
    position: sticky;
    top: 0;
    /* Above the page and above the mobile panel that hangs off it, and above
       the hero's own fire canvas. */
    z-index: 50;
    /* Opaque: the page — fire included — passes behind it, and a transparent
       bar over a wildfire is not a bar. */
    background: var(--color-paper);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease;
  }

  /* Only once something has gone under it. At the top of the page the header
     should read as part of the paper, not as a bar sitting on it. */
  .site-header.is-stuck {
    border-bottom-color: var(--color-rule);
  }

  /* Hamburger to close: the two bars cross into an X. Driven by aria-expanded,
     the same state that opens the panel, so the two can never drift out of sync. */
  #menu-toggle span {
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  #menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  #menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* Mobile panel: drops from under the header and fades. `visibility` carries
     the timing — it turns visible the instant the panel opens, and hidden only
     once the fade-out has finished, so a closed panel is out of the tab order
     and off the screen rather than a transparent trap. */
  #mobile-nav {
    opacity: 0;
    transform: translateY(-16px);
    visibility: hidden;
    transition:
      opacity 240ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 240ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 240ms;
  }

  #mobile-nav.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 240ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 240ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    #menu-toggle span,
    #mobile-nav {
      transition: none;
    }
  }
</style>

<script>
  // Live studio time. ~300 bytes; the only script on the homepage besides the filter.
  const el = document.getElementById('local-time');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Africa/Lagos',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      const now = new Date();
      el.textContent = fmt.format(now);
      el.setAttribute('datetime', now.toISOString());
    };
    tick();
    setInterval(tick, 30_000);
  }

  /* The rule under the header appears only once the page has moved. One
     class, rAF-throttled, so a scroll listener on every page stays cheap. */
  const header = document.querySelector('[data-header]');
  if (header) {
    let ticking = false;
    const mark = () => {
      ticking = false;
      header.classList.toggle('is-stuck', window.scrollY > 8);
    };
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(mark);
      },
      { passive: true },
    );
    mark();
  }

  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => {
    setMenu(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // The panel now floats over the page, so it needs the usual ways out of one.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    const target = e.target as Node;
    if (!nav?.contains(target) && !toggle.contains(target)) setMenu(false);
  });
</script>
