---
/**
 * Homepage teaser for /work/campaigns — a coverflow.
 *
 * The pieces sit on a 3D rack: the centred one square to the viewer, the rest
 * turned away and receding, and the rack advances on its own.
 *
 * It replaces the scroll-scrubbed deal-and-drift, and with it the paper tilt
 * the board uses. The two metaphors do not mix — a card cannot be both a print
 * lying on a wall and a sleeve standing in a rack — so the strip trades that
 * coherence for the motion. The board keeps the tilt.
 *
 * The client row directly above also moves on its own. They are deliberately
 * unalike: that one slides laterally and never stops, this one turns in place
 * and holds each piece for a beat.
 *
 * WCAG 2.2.2 wants a way to stop anything that moves by itself for more than
 * five seconds, so the pause control is a requirement rather than a nicety. It
 * also stops on hover, on focus and when the tab is hidden.
 *
 * Two things lead to the gallery: the rack and the button under the heading.
 * Not the whole section — a sheet stretched over everything makes the heading
 * and the lede look clickable when they are not, and it had to be switched off
 * on touch because an invisible layer over the rack swallows a swipe.
 *
 * The rack's anchor is hidden from assistive tech and out of the tab order: it
 * wraps only decorative images and goes where the visible button already goes,
 * so announcing it twice would be noise.
 */
import { Image } from 'astro:assets';
import { CAMPAIGNS } from '../data/site';

/** Chosen for recognition and for variety of shape along the rack. */
const FEATURED = [
  'sterling-multiverse-portrait.webp',
  'gtbank-737-mobile.webp',
  'kfc-doublicious.webp',
  'eat-drink-ribs.webp',
  'mtn-traveling-abroad.webp',
  'sterling-teambonding.webp',
  'kairos-ramadan.webp',
  'insidify-childs-play.webp',
];

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);

const pieces = FEATURED.map((name) => {
  const meta = CAMPAIGNS.find((c) => c.image === name);
  const hit = Object.keys(files).find((k) => k.endsWith(`/${name}`));
  return { ...meta, img: hit ? files[hit].default : undefined };
}).filter((p) => p.img);

const brands = [...new Set(CAMPAIGNS.map((c) => c.client))].length;
const INTERVAL = 3600;
---

<section
  class="frame rule-t py-14 md:py-22"
  aria-labelledby="campaigns-heading"
  data-flow
  style={`--flow-interval:${INTERVAL}ms`}
>
  <div class="gutter">
    <div class="md:flex md:items-end md:justify-between md:gap-10">
      <div class="max-w-xl">
        <p class="label mb-4">Campaigns</p>
        <h2
          id="campaigns-heading"
          class="font-display text-[32px] leading-tight tracking-tight md:text-[44px]"
        >
          Print, social and digital ads
        </h2>
        <p class="mt-5 text-soft">
          Campaign work for banks, telcos and restaurant brands &mdash; {CAMPAIGNS.length}
          pieces across {brands} names.
        </p>
      </div>

      <div class="frame__actions">
        <button type="button" class="flow__pause" data-flow-toggle aria-label="Pause">
          <span class="flow__icon" aria-hidden="true"></span>
        </button>
        <a href="/work/campaigns/" class="strip-cta">
          See the gallery <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <a class="flow" href="/work/campaigns/" aria-hidden="true" tabindex="-1">
    <ul class="flow__track">
      {
        pieces.map((p, i) => (
          <li class="flow__item" data-flow-item={i}>
            <Image
              src={p.img!}
              alt=""
              widths={[300, 600]}
              sizes="260px"
              loading="lazy"
              decoding="async"
              class="flow__img"
            />
          </li>
        ))
      }
    </ul>
  </a>
</section>

<style>
  .frame {
    position: relative;
  }

  .frame__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    flex: none;
  }
  @media (min-width: 768px) {
    .frame__actions { margin-top: 0; }
  }

  .strip-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 3px;
    transition: border-color 200ms ease;
  }

  /* Hovering the rack lights the button, so it reads as the same destination
     rather than two unrelated targets. */
  .frame:has(.flow:hover) .strip-cta,
  .strip-cta:hover,
  .strip-cta:focus-visible {
    border-color: var(--color-ink);
  }

  .flow__pause {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-faint);
    cursor: pointer;
  }
  .flow__pause:hover { color: var(--color-ink); }
  .flow__pause:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Two bars for pause; the paused state swaps to a single triangle. */
  .flow__icon {
    width: 9px;
    height: 11px;
    border-left: 2.5px solid currentColor;
    border-right: 2.5px solid currentColor;
  }
  .frame.is-paused .flow__icon {
    width: 0;
    height: 0;
    border-left: 9px solid currentColor;
    border-right: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }

  /* ── the rack ───────────────────────────────────────────────────── */
  .flow {
    display: block;
    position: relative;
    cursor: pointer;
    margin-top: 2.5rem;
    height: 300px;
    /* The depth of the room. Shallower than the classic cover flow, because a
       hard vanishing point reads as a widget; this should read as a rack of
       printed pieces seen slightly from the side. */
    perspective: 1500px;
    perspective-origin: 50% 50%;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .flow { height: 380px; margin-top: 3.5rem; }
  }

  .flow__track {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
  }

  .flow__item {
    position: absolute;
    top: 50%;
    left: 50%;
    /* JS owns the transform: the angle and depth of a piece depend on its
       distance from the centre, which is a running value rather than a
       stylesheet one. */
    transform: translate(-50%, -50%);
    transition:
      transform 760ms cubic-bezier(0.22, 0.72, 0.24, 1),
      opacity 760ms ease;
    will-change: transform;
  }

  .flow__img {
    display: block;
    height: 220px;
    width: auto;
    border: 1px solid rgb(23 22 15 / 0.1);
    border-radius: 3px;
    box-shadow:
      0 2px 8px rgb(23 22 15 / 0.08),
      0 22px 48px rgb(23 22 15 / 0.14);
    transition: box-shadow 350ms ease;
  }
  @media (min-width: 768px) {
    .flow__img { height: 300px; }
  }

  /* The whole rack lifts together, because the whole rack is one target. */
  .flow:hover .flow__img {
    box-shadow:
      0 6px 14px rgb(23 22 15 / 0.1),
      0 30px 62px rgb(23 22 15 / 0.18);
  }

  /* No motion at all where it is not wanted: the rack lays out once, flat and
     evenly spaced, and never advances. */
  @media (prefers-reduced-motion: reduce) {
    .flow__item,
    .flow__img { transition: none; }
  }
</style>

<script>
  /**
   * The coverflow.
   *
   * Each piece's angle, depth and scale come from its distance to the centre,
   * so the layout is one function of one number. The offset wraps at the
   * halfway point, which is what lets the rack turn forever in one direction
   * without a seam or a duplicated set.
   */
  const root = document.querySelector<HTMLElement>('[data-flow]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-flow-item]')];

  if (root && items.length) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-flow-toggle]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const interval =
      parseInt(getComputedStyle(root).getPropertyValue('--flow-interval')) || 3600;
    const n = items.length;

    let active = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    /** Stopped by the button — sticky, unlike hover. */
    let stopped = reduced.matches;

    const narrow = () => window.innerWidth < 768;

    const layout = () => {
      /* Pieces vary in width — portrait posters beside square social crops —
         so a fixed spread leaves uneven gaps. Set wide enough that the widest
         neighbour still clears the centred piece. */
      const spread = narrow() ? 112 : 174;
      const depth = narrow() ? 150 : 210;

      items.forEach((el, i) => {
        // Shortest way round, so the rack never unwinds the long way.
        let off = i - active;
        if (off > n / 2) off -= n;
        if (off < -n / 2) off += n;

        const dist = Math.abs(off);
        const turn = Math.max(-52, Math.min(52, -off * 40));
        const scale = Math.max(0.62, 1 - dist * 0.13);

        el.style.transform = [
          'translate(-50%, -50%)',
          `translateX(${off * spread}px)`,
          `translateZ(${-dist * depth}px)`,
          `rotateY(${turn}deg)`,
          `scale(${scale})`,
        ].join(' ');
        // Beyond the third neighbour a piece is a smudge; fading it out keeps
        // the edges of the rack clean without hiding anything a viewer wanted.
        el.style.opacity = String(dist > 3 ? 0 : Math.max(0, 1 - dist * 0.22));
        el.style.zIndex = String(100 - Math.round(dist * 10));
      });
    };

    const stop = () => {
      clearInterval(timer);
      timer = undefined;
    };

    const run = () => {
      if (stopped || document.hidden) return;
      stop();
      timer = setInterval(() => {
        active = (active + 1) % n;
        layout();
      }, interval);
    };

    /** Hover and focus hold it without changing what the button says. */
    const hold = () => stop();
    const release = () => {
      if (!stopped) run();
    };

    toggle?.addEventListener('click', (e) => {
      // The frame is a link; this button is not a way through it.
      e.preventDefault();
      e.stopPropagation();
      stopped = !stopped;
      root.classList.toggle('is-paused', stopped);
      toggle.setAttribute('aria-label', stopped ? 'Play' : 'Pause');
      if (stopped) stop();
      else run();
    });

    root.addEventListener('pointerenter', hold);
    root.addEventListener('pointerleave', release);
    root.addEventListener('focusin', hold);
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) release();
    });

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : release()));

    // The spread and depth are viewport-dependent, so a resize re-lays it out.
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(layout, 120);
    });

    layout();

    if (stopped) {
      root.classList.add('is-paused');
      toggle?.setAttribute('aria-label', 'Play');
    } else {
      run();
    }
  }
</script>
