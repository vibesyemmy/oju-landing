---
/**
 * Homepage teaser for /work/campaigns.
 *
 * Without this the gallery had exactly one inbound link, at the foot of /work —
 * two clicks deep, below five case studies. That is a poor place for the most
 * visually striking material the studio has.
 *
 * The pieces carry the same angles they have on the board, from the same seed,
 * so the teaser looks like the place it leads to rather than a second
 * treatment of the same artwork.
 *
 * Two scroll-driven motions, on different elements so their transforms cannot
 * collide: the cards deal in as the section arrives, and the items drift
 * sideways at slightly different rates for the rest of the time it is on
 * screen. Both are scrubbed by scroll rather than autoplayed — the client row
 * directly above moves on its own, and two self-moving strips fight each other.
 *
 * The whole frame is one link, as a stretched pseudo-element on the real anchor
 * rather than a wrapper: wrapping the section would fold the heading and every
 * caption into that link's name.
 */
import { Image } from 'astro:assets';
import { CAMPAIGNS } from '../data/site';
import { tilt } from '../lib/tilt';

/** Chosen for recognition and for variety of shape along the strip. */
const FEATURED = [
  'sterling-multiverse-portrait.webp',
  'gtbank-737-mobile.webp',
  'kfc-doublicious.webp',
  'eat-drink-ribs.webp',
  'mtn-traveling-abroad.webp',
  'sterling-teambonding.webp',
  'kairos-ramadan.webp',
  'insidify-childs-play.webp',
];

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);

const pieces = FEATURED.map((name) => {
  const meta = CAMPAIGNS.find((c) => c.image === name);
  const hit = Object.keys(files).find((k) => k.endsWith(`/${name}`));
  return { ...meta, ...tilt(name), img: hit ? files[hit].default : undefined };
}).filter((p) => p.img);

const brands = [...new Set(CAMPAIGNS.map((c) => c.client))].length;
---

<section class="frame rule-t py-14 md:py-22" aria-labelledby="campaigns-heading">
  <div class="gutter">
    <div class="md:flex md:items-end md:justify-between md:gap-10">
      <div class="max-w-xl">
        <p class="label mb-4">Campaigns</p>
        <h2
          id="campaigns-heading"
          class="font-display text-[32px] leading-tight tracking-tight md:text-[44px]"
        >
          Print, social and digital ads
        </h2>
        <p class="mt-5 text-soft">
          Campaign work for banks, telcos and restaurant brands &mdash; {CAMPAIGNS.length}
          pieces across {brands} names.
        </p>
      </div>
      <a href="/work/campaigns/" class="strip-cta">
        See the gallery <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <ul class="strip">
    {
      pieces.map((p, i) => (
        <li class="strip__item" style={`--i:${i}`}>
          <div class="strip__card" style={`--rot:${p.rot}deg`}>
            <Image
              src={p.img!}
              alt=""
              widths={[300, 600]}
              sizes="260px"
              loading="lazy"
              decoding="async"
              class="strip__img"
            />
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .frame {
    position: relative;
  }
  @media (hover: hover) {
    .frame { cursor: pointer; }
  }

  .strip-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    flex: none;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 3px;
    transition: border-color 200ms ease;
  }
  @media (min-width: 768px) {
    .strip-cta { margin-top: 0; }
  }

  /* The whole frame is the target, as a stretched pseudo-element: one link,
     with the name the anchor already has. */
  .strip-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* Touch has no hover, and an overlay laid across a scrolling strip swallows
     the swipe. There the strip scrolls and the visible link is the way through. */
  @media (hover: none) {
    .strip-cta::after { display: none; }
  }

  .frame:hover .strip-cta,
  .strip-cta:focus-visible {
    border-color: var(--color-ink);
  }

  .strip {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    scroll-padding-inline-start: var(--gutter);
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) {
    .strip { gap: 1.75rem; margin-top: 3.5rem; }
  }

  /* With a pointer the frame is a link, so the strip does not need to scroll —
     and `clip` matters for more than that: `auto` makes this a scroll
     container, and a view() timeline resolves against the nearest one, so the
     cards inside would have been measured against the strip rather than the
     page and never moved at all. `clip` does not create one. */
  @media (hover: hover) {
    .strip { overflow-x: clip; }
  }

  .strip__item {
    flex: none;
  }

  /* The angle it has on the board, from the same seed. */
  .strip__card {
    transform: rotate(var(--rot, 0deg));
  }

  .strip__img {
    display: block;
    height: 200px;
    width: auto;
    border: 1px solid rgb(23 22 15 / 0.1);
    border-radius: 3px;
    box-shadow:
      0 2px 6px rgb(23 22 15 / 0.07),
      0 14px 34px rgb(23 22 15 / 0.06);
    transition: box-shadow 350ms ease;
  }
  @media (min-width: 768px) {
    .strip__img { height: 260px; }
  }

  /* One hover state for the whole frame, because the whole frame is one link. */
  .frame:hover .strip__img {
    box-shadow:
      0 6px 14px rgb(23 22 15 / 0.09),
      0 26px 56px rgb(23 22 15 / 0.12);
  }

  /* ── the two motions ──────────────────────────────────────────────
     Deal lands on the card (transform), drift on the item (translate), so
     neither overwrites the other's property. */
  @keyframes strip-deal {
    from {
      opacity: 0;
      transform: translate(-38px, 14px) rotate(0deg) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(var(--rot, 0deg)) scale(1);
    }
  }

  @keyframes strip-drift {
    from { translate: calc(26px + var(--i) * 3px) 0; }
    to   { translate: calc(-26px - var(--i) * 3px) 0; }
  }

  @supports (animation-timeline: view()) {
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .strip__card {
        animation: strip-deal linear both;
        animation-timeline: view();
        /* Dealt out well before the section settles, so it reads as arrival
           rather than something still happening while you read.

           Staggered by shifting each card's range, not by animation-delay: a
           delay is measured in time, and a scrubbed animation has no clock for
           it to run against, so it is ignored outright. The first attempt used
           one and every card dealt in unison. */
        animation-range-start: entry calc(6% + var(--i) * 3%);
        animation-range-end: cover calc(26% + var(--i) * 3%);
      }

      .strip__item {
        animation: strip-drift linear both;
        animation-timeline: view();
        animation-range: cover;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .strip__img { transition: none; }
  }
</style>
