---
/**
 * Homepage teaser for /work/campaigns.
 *
 * Without this the gallery had exactly one inbound link, at the foot of /work —
 * two clicks deep, below five case studies. That is a poor place for the most
 * visually striking material the studio has.
 *
 * A filmstrip rather than a grid: these pieces are square, portrait and one
 * wide banner, and any fixed cell either crops a headline in half or leaves
 * every short piece letterboxed. Matching on height instead lets each keep its
 * real proportions, and the ragged right edge is what tells you it continues.
 *
 * Deliberately not a marquee. The client row above already scrolls on its own,
 * and two auto-moving strips on one page fight each other.
 */
import { Image } from 'astro:assets';
import { CAMPAIGNS } from '../data/site';

/** Chosen for recognition and for variety of shape along the strip. */
const FEATURED = [
  'sterling-multiverse-portrait.webp',
  'gtbank-737-mobile.webp',
  'kfc-doublicious.webp',
  'eat-drink-ribs.webp',
  'mtn-traveling-abroad.webp',
  'sterling-teambonding.webp',
  'kairos-ramadan.webp',
  'insidify-childs-play.webp',
];

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/campaigns/*.{webp,png,jpg,jpeg}',
  { eager: true },
);

const pieces = FEATURED.map((name) => {
  const meta = CAMPAIGNS.find((c) => c.image === name);
  const hit = Object.keys(files).find((k) => k.endsWith(`/${name}`));
  return { ...meta, img: hit ? files[hit].default : undefined };
}).filter((p) => p.img);

const brands = [...new Set(CAMPAIGNS.map((c) => c.client))].length;
---

<section class="rule-t py-14 md:py-22" aria-labelledby="campaigns-heading">
  <div class="gutter">
    <div class="md:flex md:items-end md:justify-between md:gap-10">
      <div class="max-w-xl">
        <p class="label mb-4">Campaigns</p>
        <h2
          id="campaigns-heading"
          class="font-display text-[32px] leading-tight tracking-tight md:text-[44px]"
        >
          Print, social and digital ads
        </h2>
        <p class="mt-5 text-soft">
          Campaign work for banks, telcos and restaurant brands &mdash; {CAMPAIGNS.length}
          pieces across {brands} names.
        </p>
      </div>
      <a href="/work/campaigns/" class="strip-cta">
        See the gallery <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <ul class="strip">
    {
      pieces.map((p) => (
        <li class="strip__item">
          <a href="/work/campaigns/" tabindex="-1" aria-hidden="true">
            <Image
              src={p.img!}
              alt=""
              widths={[300, 600]}
              sizes="260px"
              loading="lazy"
              decoding="async"
              class="strip__img"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .strip-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
    flex: none;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 3px;
    transition: border-color 200ms ease;
  }
  .strip-cta:hover,
  .strip-cta:focus-visible {
    border-color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .strip-cta { margin-top: 0; }
  }

  /* One row, matched on height. Scrolls rather than wrapping: a strip that
     wraps stops reading as a strip. */
  .strip {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    /* Snap points align to the scrollport edge, which sits inside the padding —
       without this the first item snaps flush to the viewport and swallows the
       gutter the heading is aligned to. */
    scroll-padding-inline-start: var(--gutter);
    /* The images carry the page's own edges; no scrollbar furniture. */
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) {
    .strip {
      gap: 1.25rem;
      padding: 0 var(--gutter);
      scroll-padding-inline-start: var(--gutter);
      margin-top: 3.5rem;
    }
  }

  .strip__item {
    flex: none;
    scroll-snap-align: start;
  }

  .strip__img {
    display: block;
    height: 200px;
    width: auto;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    transition: transform 350ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  @media (min-width: 768px) {
    .strip__img { height: 260px; }
  }
  .strip__item:hover .strip__img {
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .strip__img,
    .strip__item:hover .strip__img {
      transition: none;
      transform: none;
    }
  }
</style>
