# Copy to .env and fill in. .env is gitignored; this file is not.

# ─── Contact form ─────────────────────────────────────────────────────
# THIS ONE IS A SECRET. No PUBLIC_ prefix — it must stay server-side, and
# is read by the contact API route at request time, not by Astro at build time.
# Set it in the Vercel project's environment variables, never in the repo.
CONTACT_WEBHOOK_URL=
